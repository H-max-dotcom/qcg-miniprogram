.marketing-icon{display:inline-block;position:relative;width:38rpx;height:38rpx;box-sizing:border-box;border:3rpx solid currentColor;border-radius:8rpx;color:#217554;flex-shrink:0}.marketing-icon::before,.marketing-icon::after{content:'';position:absolute;box-sizing:border-box}.marketing-icon::before{left:7rpx;right:7rpx;top:9rpx;height:3rpx;background:currentColor;box-shadow:0 9rpx 0 currentColor}.marketing-icon.category::before{left:15rpx;top:0;bottom:0;width:3rpx;height:auto;box-shadow:none}.marketing-icon.category::after{left:0;right:0;top:15rpx;height:3rpx;background:currentColor}.marketing-icon.campaigns{transform:rotate(-12deg);border-radius:5rpx}.marketing-icon.campaigns::after{right:-9rpx;bottom:-8rpx;width:12rpx;height:16rpx;border-left:3rpx solid currentColor;transform:rotate(-20deg)}.marketing-icon.coupon{width:44rpx;height:32rpx;border-style:dashed}.marketing-icon.coupon::before{top:6rpx;box-shadow:0 9rpx 0 currentColor}.marketing-icon.frequent,.marketing-icon.restock,.marketing-icon.cart{height:30rpx;border-top:0;transform:skew(-8deg)}.marketing-icon.frequent::before,.marketing-icon.restock::before,.marketing-icon.cart::before{top:34rpx;left:3rpx;width:6rpx;height:6rpx;border-radius:50%;box-shadow:22rpx 0 0 currentColor}.marketing-icon.membership,.marketing-icon.me,.marketing-icon.service{border-radius:50%}.marketing-icon.membership::before,.marketing-icon.me::before,.marketing-icon.service::before{width:11rpx;height:11rpx;top:5rpx;left:10rpx;border-radius:50%;box-shadow:none}.marketing-icon.membership::after,.marketing-icon.me::after,.marketing-icon.service::after{width:22rpx;height:11rpx;left:5rpx;bottom:3rpx;border:3rpx solid currentColor;border-radius:16rpx 16rpx 6rpx 6rpx}.marketing-icon.address{border-radius:50% 50% 50% 0;transform:rotate(-45deg);width:30rpx;height:30rpx}.marketing-icon.address::before{width:9rpx;height:9rpx;border-radius:50%;top:8rpx;left:8rpx;box-shadow:none}.marketing-icon.home{border-radius:3rpx;border-top:0;height:28rpx;margin-top:10rpx}.marketing-icon.home::before{width:27rpx;height:27rpx;left:3rpx;top:-13rpx;background:transparent;border-top:3rpx solid currentColor;border-left:3rpx solid currentColor;transform:rotate(45deg);box-shadow:none}.marketing-icon.home::after{width:9rpx;height:15rpx;border:3rpx solid currentColor;border-bottom:0;bottom:0;left:11rpx}
