<view class="page no-tab account-page">
  <view class="mini-topbar">
    <button class="icon-btn" bindtap="goBack">‹</button>
    <view class="brand">
      <text class="brand-title">预付款账户</text>
      <text class="brand-subtitle">余额明细 · 账户记录</text>
    </view>
  </view>

  <view class="loading" wx:if="{{viewState === 'LOADING'}}">账户数据加载中…</view>

  <view class="error-state" wx:if="{{viewState === 'ERROR'}}">
    <view>{{errorMessage}}</view>
    <button class="button-primary state-action" bindtap="retry">重新加载</button>
  </view>

  <view class="empty" wx:if="{{viewState === 'EMPTY'}}">
    <view class="empty-title">暂无预存账户记录</view>
    <view>当前暂无预存账户。如需了解预存方式，请联系业务员。</view>
  </view>

  <view class="error-state" wx:if="{{viewState === 'UNAVAILABLE'}}">
    <view>{{errorMessage || account.message || '账户数据暂不可用'}}</view>
    <view class="state-note">暂时无法确认账户余额，请稍后重试或联系业务员。</view>
    <button class="button-primary state-action" bindtap="retry">重新核验</button>
  </view>

  <block wx:if="{{viewState === 'READY'}}">
    <view class="account-hero">
      <text class="account-label">可用预付款余额</text>
      <text class="account-amount">{{account.balances.availableBalanceText}}</text>
      <text class="account-caption">账面余额扣除订单占用后可用于新订单的金额</text>
    </view>

    <view class="section balance-section">
      <view class="section-head"><text>余额构成</text><text class="tag">已核验</text></view>
      <view class="balance-grid">
        <view><text>账面余额</text><text>{{account.balances.bookBalanceText}}</text></view>
        <view><text>订单占用</text><text>{{account.balances.reservedBalanceText}}</text></view>
        <view><text>累计预存</text><text>{{account.balances.cumulativeDepositedText}}</text></view>
        <view><text>累计消费</text><text>{{account.balances.cumulativeConsumedText}}</text></view>
      </view>
      <view class="notice unavailable-metric">累计活动优惠：{{account.cumulativeMarketingDiscountMessage}}</view>
    </view>

    <view class="section">
      <view class="section-head"><text>余额明细</text><text class="small">最近记录</text></view>
      <view class="empty ledger-empty" wx:if="{{!account.ledger.length}}">暂无账户流水</view>
      <view class="ledger-list" wx:else>
        <view class="ledger-row" wx:for="{{account.ledger}}" wx:key="id">
          <view class="ledger-main">
            <text class="ledger-title">{{item.title}}</text>
            <text class="ledger-reference">{{item.description}}</text>
            <text class="ledger-order" wx:if="{{item.payment.kind === 'BATCH'}}">批量付款 · 结清 {{item.payment.settledCount}} 笔</text>
            <text class="ledger-order" wx:if="{{item.order}}">订单 {{item.order.orderNo}}</text>
            <text class="ledger-time">{{item.occurredAtText}}</text>
            <button class="ledger-payment-link" wx:if="{{item.payment}}" data-payment-id="{{item.payment.id}}" bindtap="openPayment">查看付款详情 ›</button>
            <button class="ledger-payment-link" wx:elif="{{item.order}}" data-order-id="{{item.order.id}}" bindtap="openOrder">查看订单 ›</button>
          </view>
          <view class="ledger-amount {{item.direction === 'DECREASE' ? 'decrease' : item.direction === 'HOLD' ? 'hold' : 'increase'}}">
            <text>{{item.directionText}}</text>
            <text>{{item.amountText}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="notice account-note">
      余额和流水以最新账户记录为准。
    </view>
  </block>

  <view class="section" wx:if="{{onlineDepositEnabled}}">
    <view class="section-head"><text>在线预存</text><text class="tag">微信支付</text></view>
    <view class="balance-grid">
      <button class="{{depositPreset === '100' ? 'button-primary' : 'button-secondary'}}" data-amount="100" bindtap="selectDepositPreset">¥100</button>
      <button class="{{depositPreset === '500' ? 'button-primary' : 'button-secondary'}}" data-amount="500" bindtap="selectDepositPreset">¥500</button>
      <button class="{{depositPreset === '1000' ? 'button-primary' : 'button-secondary'}}" data-amount="1000" bindtap="selectDepositPreset">¥1000</button>
    </view>
    <input type="digit" value="{{depositAmount}}" bindinput="onDepositAmountInput" placeholder="自定义金额（0.01-50000）" />
    <button class="button-primary state-action" loading="{{paymentPending}}" disabled="{{paymentPending}}" bindtap="startOnlineDeposit">确认微信支付</button>
    <view class="small">支付完成后，可下拉刷新查看账户记录。</view>
  </view>

  <view class="section" wx:if="{{onlineDepositEnabled && onlineDepositHistory.length}}">
    <view class="section-head"><text>在线预存记录</text><text class="small">最近 50 笔</text></view>
    <view class="ledger-list"><view class="ledger-row" wx:for="{{onlineDepositHistory}}" wx:key="id"><view class="ledger-main"><text class="ledger-title">{{item.amountText}} · {{item.statusText}}</text><text class="ledger-time">{{item.createdAtText}}</text></view></view></view>
  </view>
</view>
