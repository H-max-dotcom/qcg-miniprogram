<view class="page home-page" style="{{bottomClearance ? 'padding-bottom: ' + bottomClearance + 'px;' : ''}}">
 <scroll-view class="home-scroll" scroll-y enhanced show-scrollbar="{{false}}" refresher-enabled refresher-triggered="{{refreshing}}" bindrefresherrefresh="onPullDownRefresh">
 <view class="home-content">
  <delivery-promise wx:if="{{customerMode === 'BOUND'}}" storefront-code="{{storefrontCode}}" />
<view wx:if="{{receivableSummary && customerMode === 'BOUND'}}" class="receivable-summary" style="order: {{homepageV2Enabled ? homepageModuleOrder.quickEntries + 2 : 1}};" bindtap="goReceivableCenter"><view><text>待付款 {{receivableSummary.totalCount}}笔</text><text class="receivable-summary-arrow">¥{{receivableSummary.totalAmount}} · 查看明细 ›</text></view><view class="receivable-summary-meta">今日 {{receivableSummary.todayCount}} 笔 / ¥{{receivableSummary.todayAmount}}</view></view>
  <campaign-return wx:if="{{!loading && !errored && customerMode === 'BOUND'}}" customer-status="{{customerStatus}}" storefront-code="{{storefrontCode}}" />
  <view class="topbar">
    <view class="brand">
      <text class="brand-title">全渠供</text>
      <text class="brand-subtitle">{{storefront.name}} · {{customerStatusText}}</text>
    </view>
    <view class="tag orange">{{memberTagText}}</view>
  </view>

  <view class="search-row" wx:if="{{!homepageV2Enabled || homepageModules.search}}" style="order: {{homepageV2Enabled ? homepageModuleOrder.search : 0}};">
    <view class="search">
      <view class="search-field">
        <input
          class="search-input"
          value="{{searchKeyword}}"
          bindinput="inputSearch"
          bindconfirm="onSearch"
          confirm-type="search"
          placeholder="搜索商品名 / 编码 / 条码 / 品牌"
        />
        <button wx:if="{{searchKeyword}}" class="button-clear" catchtap="clearSearch">×</button>
      </view>
      <button class="button-primary search-submit" bindtap="search">搜索</button>
    </view>
  </view>

  <view wx:if="{{loading}}" class="section empty" style="order: 1000;">正在加载商品…</view>
  <view wx:elif="{{errored}}" class="section empty" style="order: 1000;">
    <view>商城数据暂不可用，请稍后重试</view>
    <button class="button-primary" bindtap="reload">重新加载</button>
  </view>

  <block wx:else>
  <mall-promo-banner
    id="homepage-banner" class="home-hero-slot"
    wx:if="{{homepageV2Enabled && homepageModules.banner && banners.length}}"
    banners="{{banners}}"
    activities="{{[]}}"
    bind:select="onBannerSelect"
    style="order: {{homepageModuleOrder.banner}};"
  />
  <mall-promo-banner
    id="homepage-campaign-hero" class="home-hero-slot"
    wx:if="{{homepageV2Enabled && homepageModules.banner && !banners.length && marketingState === 'READY' && marketingHeroCampaigns.length}}"
    banners="{{marketingHeroCampaigns}}"
    bind:select="onCampaignHeroSelect"
    style="order: {{homepageModuleOrder.banner}};"
  />
  <view class="hero-card" wx:elif="{{!homepageV2Enabled}}" bindtap="goCategory">
    <view class="row">
      <view class="hero-copy">
        <text class="tag">{{apiStateText}}</text>
        <text class="hero-title" style="margin-top: 14rpx;">{{heroTitle}}</text>
        <text class="small">{{heroSubtitle}}</text>
        <view class="hero-actions">
          <text class="button-plain" style="background: rgba(255,255,255,0.18); color: #fff; border-color: rgba(255,255,255,0.42);">{{heroButtonText}}</text>
        </view>
      </view>
      <view class="hero-visual"><view class="marketing-icon restock"></view></view>
    </view>
  </view>

  <mall-quick-entry
    id="homepage-quick-entries" class="home-quick-slot"
    wx:if="{{homepageV2Enabled && homepageModules.quickEntries && quickEntries.length}}"
    entries="{{quickEntries}}"
    bind:entrytap="onQuickTap"
    style="order: {{homepageModuleOrder.quickEntries}};"
  />

  <view wx:if="{{homepageV2Enabled && announcement}}" class="home-announcement" style="order: {{homepageModuleOrder.quickEntries + 1}};">{{announcement}}</view>
  <view class="stats" wx:if="{{!homepageV2Enabled || !homepageModules.quickEntries || !quickEntries.length}}" style="order: {{homepageV2Enabled ? homepageModuleOrder.quickEntries + 1 : 0}};">
    <button class="stat-card" bindtap="goMe"><strong>{{memberTagText}}</strong><text>门店状态</text></button>
    <button class="stat-card" bindtap="goOrders"><strong>查订单</strong><text>我的订单</text></button>
    <button class="stat-card" bindtap="goCart"><strong>{{cartCount}} 件</strong><text>购物车</text></button>
    <button class="stat-card" bindtap="goCategory"><strong>{{restockStatText}}</strong><text>常买待补</text></button>
  </view>

  <view class="section" wx:if="{{!homepageV2Enabled}}">
    <view class="section-head">
      <text>商品分类</text>
      <text class="tag gray">全部</text>
    </view>
    <view class="category-grid">
      <button class="category-tile" wx:for="{{categories}}" wx:key="id" data-id="{{item.id}}" bindtap="goCategory">
        <text class="category-badge" wx:if="{{item.badge}}">{{item.badge}}</text>
        <image wx:if="{{item.imageUrl}}" class="category-photo" src="{{item.imageUrl}}" mode="aspectFit" /><view wx:else class="category-art"><view class="marketing-icon category"></view></view>
        <text class="category-name">{{item.name}}</text>
      </button>
      <button class="category-tile category-tile--all" bindtap="goCategoryAll">
        <view class="category-art"><view class="marketing-icon category"></view></view>
        <text class="category-name">全部分类</text>
      </button>
    </view>
  </view>

  <view class="section" wx:if="{{!homepageV2Enabled}}">
    <view class="section-head">
      <text>本周活动</text>
      <text class="tag orange" wx:if="{{activities.length}}">活动资讯</text>
    </view>
    <view class="promo-list" wx:if="{{activities.length}}">
      <view class="promo-card {{index % 2 ? 'green' : ''}}" wx:for="{{activities}}" wx:key="id" bindtap="onActivity">
        <view class="row">
          <view class="promo-copy">
            <view class="product-name">{{item.title}}</view>
            <view class="spec">{{item.subtitle}}</view>
            <view class="labels"><text class="tag orange">查看活动</text></view>
          </view>
          <view class="pic">
            <image wx:if="{{item.imageUrl}}" class="product-image" src="{{item.imageUrl}}" mode="aspectFill" />
            <text wx:else class="product-photo-empty">暂无图片</text>
          </view>
        </view>
      </view>
    </view>
    <view class="empty" wx:else>本周暂无活动</view>
  </view>

  <view class="section" wx:if="{{!homepageV2Enabled}}">
    <view class="section-head">
      <text>常买待补</text>
      <text class="tag">按购买记录推荐</text>
    </view>
    <view class="product-grid">
      <view class="mini-product" wx:for="{{restockProducts}}" wx:key="lineKey">
        <button data-id="{{item.productId}}" bindtap="goProduct">
          <view class="pic">
            <image wx:if="{{item.imageUrl && !item.imageFailed}}" class="product-image" src="{{item.imageUrl}}" mode="aspectFit" data-key="{{item.lineKey}}" data-src="{{item.imageUrl}}" binderror="onProductImageError" />
            <image wx:else class="product-image" src="/assets/product-placeholder.png" mode="aspectFit" />
          </view>
          <view class="product-name" style="margin-top: 10rpx;">{{item.name}}</view>
          <view class="spec">{{item.spec}}</view>
        </button>
        <view class="price-line">
          <text wx:if="{{item.priceVisible}}" class="money">{{item.priceText}}</text>
          <text wx:else class="blank-price">登录后查看价格</text>
          <button wx:if="{{customerMode === 'BOUND' && item.canOrder}}" class="add-btn" data-key="{{item.lineKey}}" catchtap="addCart">+</button>
          <text wx:else class="blank-price">{{item.priceUnavailableText}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="section" wx:if="{{!homepageV2Enabled}}">
    <view class="section-head">
      <text>推荐补货</text>
      <text class="tag gray">为您推荐</text>
    </view>
    <view class="product-grid" wx:if="{{recommendProducts.length}}">
      <view class="mini-product" wx:for="{{recommendProducts}}" wx:key="lineKey">
        <button data-id="{{item.productId}}" bindtap="goProduct">
          <view class="pic">
            <image wx:if="{{item.imageUrl && !item.imageFailed}}" class="product-image" src="{{item.imageUrl}}" mode="aspectFit" data-key="{{item.lineKey}}" data-src="{{item.imageUrl}}" binderror="onProductImageError" />
            <image wx:else class="product-image" src="/assets/product-placeholder.png" mode="aspectFit" />
          </view>
          <view class="product-name" style="margin-top: 10rpx;">{{item.name}}</view>
          <view class="spec">{{item.spec}}</view>
          <view class="labels">
            <text class="tag gray" wx:for="{{item.tags}}" wx:key="*this">{{item}}</text>
          </view>
        </button>
        <view class="price-line">
          <text wx:if="{{item.priceVisible}}" class="money">{{item.priceText}}</text>
          <text wx:else class="blank-price">价格确认中</text>
          <button wx:if="{{customerMode === 'BOUND' && item.canOrder}}" class="add-btn" data-key="{{item.lineKey}}" catchtap="addCart">+</button>
          <text wx:else class="blank-price">{{item.priceUnavailableText}}</text>
        </view>
      </view>
    </view>
    <view class="empty" wx:else>
      <view>暂无推荐商品</view>
      <view>可以看看其他分类</view>
    </view>
  </view>

  <block wx:if="{{homepageV2Enabled}}">
    <view class="section campaign-section" wx:if="{{homepageModules.currentCampaigns && marketingState === 'READY' && marketingCampaigns.length}}" style="order: {{homepageModuleOrder.currentCampaigns}};">
      <view class="section-head"><view><text class="marketing-eyebrow">采购好活动</text><text class="marketing-heading">本期活动</text></view><text class="campaign-scroll-hint" wx:if="{{marketingCampaigns.length > 2}}">滑动查看更多 ›</text></view>
      <scroll-view class="campaign-poster-scroll" scroll-x show-scrollbar="{{false}}" enhanced>
        <view class="campaign-poster-rail {{marketingCampaigns.length === 1 ? 'campaign-poster-rail-single' : ''}}">
          <button class="campaign-poster" wx:for="{{marketingCampaigns}}" wx:key="code" data-code="{{item.code}}" bindtap="openMarketingCampaign" aria-label="{{item.name}}">
            <image wx:if="{{item.imageUrl}}" class="campaign-poster-image" src="{{item.imageUrl}}" mode="widthFix" />
            <view wx:else class="campaign-poster-fallback"><text class="campaign-poster-name">{{item.name}}</text><text class="campaign-poster-subtitle" wx:if="{{item.description}}">{{item.description}}</text></view>
            <view class="campaign-poster-caption"><text class="campaign-poster-title">{{item.name}}</text><text class="campaign-poster-description" wx:if="{{marketingCampaigns.length === 1}}">{{item.description}}</text><text class="campaign-poster-state">{{item.stateText}}</text><text class="campaign-poster-link" wx:if="{{marketingCampaigns.length === 1}}">查看活动 ›</text></view>
          </button>
        </view>
      </scroll-view>

    </view>

    <view class="section limited-time-section" wx:if="{{homepageModules.limitedTime && marketingState === 'READY' && limitedTimeCampaigns.length}}" style="order: {{homepageModuleOrder.limitedTime}};">
      <button wx:for="{{limitedTimeCampaigns}}" wx:key="code" class="marketing-feature" data-code="{{item.code}}" bindtap="openMarketingCampaign">
        <image wx:if="{{item.imageUrl}}" class="marketing-feature-image" src="{{item.imageUrl}}" mode="aspectFit" />
        <view class="marketing-feature-copy"><text class="marketing-feature-label">限时活动</text><text class="marketing-feature-title">{{item.name}}</text><text class="marketing-countdown">{{item.ended ? '' : '距结束 '}}{{item.countdownText}}</text><text class="marketing-feature-note">{{item.ended ? '查看活动详情' : '活动优惠以实时核验为准'}}</text></view>
      </button>
    </view>
    <view class="section buy-gift-section" wx:if="{{homepageModules.buyGift && marketingState === 'READY' && buyGiftCampaigns.length}}" style="order: {{homepageModuleOrder.buyGift}};">
      <button wx:for="{{buyGiftCampaigns}}" wx:key="code" class="marketing-feature" data-code="{{item.code}}" bindtap="openMarketingCampaign">
        <image wx:if="{{item.imageUrl}}" class="marketing-feature-image" src="{{item.imageUrl}}" mode="aspectFit" />
        <view class="marketing-feature-copy"><text class="marketing-feature-label">买赠活动</text><text class="marketing-feature-title">{{item.name}}</text><text class="marketing-feature-note">{{item.description || '查看活动商品与参与规则'}}</text></view>
      </button>
    </view>
    <view class="section theme-section" wx:if="{{homepageModules.featuredTheme && marketingState === 'READY' && themeCampaigns.length}}" style="order: {{homepageModuleOrder.featuredTheme}};">
      <button wx:for="{{themeCampaigns}}" wx:key="code" class="marketing-feature" data-code="{{item.code}}" bindtap="openMarketingCampaign">
        <image wx:if="{{item.imageUrl}}" class="marketing-feature-image" src="{{item.imageUrl}}" mode="aspectFit" />
        <view class="marketing-feature-copy"><text class="marketing-feature-label">主题精选</text><text class="marketing-feature-title">{{item.name}}</text><text class="marketing-feature-note">{{item.description || '查看主题精选商品'}}</text></view>
      </button>
    </view>

<view class="section featured-campaign-section" wx:if="{{homepageModules.currentCampaigns && marketingState === 'READY' && featuredCampaignProducts.length}}" style="order: {{homepageModuleOrder.currentCampaigns + 4}};">      <view class="featured-campaign-products" wx:if="{{featuredCampaignProducts.length}}"><view class="featured-campaign-heading">活动商品精选</view><view class="featured-campaign-grid {{featuredCampaignProducts.length === 1 ? 'featured-campaign-grid-single' : ''}}"><button class="featured-campaign-product" wx:for="{{featuredCampaignProducts}}" wx:key="key" data-id="{{item.productId}}" bindtap="openFeaturedCampaignProduct"><image wx:if="{{item.imageUrl && !item.imageFailed}}" class="featured-campaign-image" src="{{item.imageUrl}}" mode="aspectFit" data-key="{{item.key}}" data-src="{{item.imageUrl}}" binderror="onFeaturedProductImageError" /><image wx:else class="featured-campaign-image" src="/assets/product-placeholder.png" mode="aspectFit" /><text class="featured-campaign-name">{{item.name}}</text><text wx:if="{{item.priceText}}" class="featured-campaign-price">{{item.priceText}}</text><text wx:else class="featured-campaign-price-unavailable">价格暂不可用</text></button></view></view></view>
    <view class="section" wx:for="{{homepageShelves}}" wx:key="key" style="order: {{item.homepageOrder}};">
      <view class="section-head"><text>{{item.title}}</text><text class="tag gray">补货推荐</text></view>
      <view class="product-grid">
        <view class="mini-product" wx:for="{{item.products}}" wx:for-item="product" wx:key="lineKey">
          <button data-id="{{product.productId}}" bindtap="goProduct">
            <view class="pic">
              <image wx:if="{{product.imageUrl && !product.imageFailed}}" class="product-image" src="{{product.imageUrl}}" mode="aspectFit" data-key="{{product.lineKey}}" data-src="{{product.imageUrl}}" binderror="onProductImageError" />
              <image wx:else class="product-image" src="/assets/product-placeholder.png" mode="aspectFit" />
            </view>
            <view class="product-name" style="margin-top: 10rpx;">{{product.name}}</view>
            <view class="spec">{{product.spec}}</view><text class="purchased-label" wx:if="{{product.hasPurchased}}">买过的商品</text>
          </button>
          <view class="price-line">
            <text wx:if="{{product.priceVisible}}" class="money">{{product.priceText}}</text>
            <text wx:else class="blank-price">{{product.priceUnavailableText}}</text>
            <button wx:if="{{customerMode === 'BOUND' && product.canOrder}}" class="add-btn" data-key="{{product.lineKey}}" catchtap="addCart">+</button>
          </view>
        </view>
      </view>
    </view>

    <view class="section" wx:if="{{homepageModules.brandZone && majorBrands.length}}" style="order: {{homepageModuleOrder.brandZone}};">
      <view class="section-head"><text>品牌专区</text><text class="tag gray">精选品牌</text></view>
      <view class="category-grid">
        <button class="category-tile" wx:for="{{majorBrands}}" wx:key="name" data-brand="{{item.name}}" bindtap="goBrand">
          <text class="category-icon">{{item.initial}}</text>
          <text class="category-name">{{item.name}}</text>
        </button>
      </view>
    </view>

    <view class="section" wx:if="{{homepageModules.categorySelection && categories.length}}" style="order: {{homepageModuleOrder.categorySelection}};">
      <view class="section-head"><text>分类精选</text><text class="tag gray">商品分类</text></view>
      <view class="category-grid">
        <button class="category-tile" wx:for="{{categories}}" wx:key="id" data-id="{{item.id}}" bindtap="goCategory">
          <image wx:if="{{item.imageUrl}}" class="category-photo" src="{{item.imageUrl}}" mode="aspectFit" /><view wx:else class="category-art"><view class="marketing-icon category"></view></view>
          <text class="category-name">{{item.name}}</text>
        </button>
        <button class="category-tile category-tile--all" bindtap="goCategoryAll"><view class="category-art"><view class="marketing-icon category"></view></view><text class="category-name">全部分类</text></button>
      </view>
    </view>
  </block>
  </block>

 </view>
 </scroll-view>
  <view class="cart-float">
    <mall-cart-entry id="cart-entry" count="{{cartCount}}" selected="{{cartCount > 0}}" bind:entrytap="goCart" />
    <button class="cart-summary" bindtap="goCart">
      <view class="product-name">已选 {{cartCount}} 件</view>
      <view class="small">{{cartAmountText}}</view>
    </button>
    <button class="button-primary" bindtap="goCart">去结算</button>
  </view>

  <view class="qcg-tabbar">
    <button class="qcg-tab active"><view class="marketing-icon home"></view><text>首页</text></button>
    <button class="qcg-tab" bindtap="goCategory"><view class="marketing-icon category"></view><text>分类</text></button>
    <button class="qcg-tab" bindtap="goCart"><view class="marketing-icon cart"></view><text>购物车</text></button>
    <button class="qcg-tab" bindtap="goOrders"><view class="marketing-icon orders"></view><text>订单</text></button>
    <button class="qcg-tab" bindtap="goMe"><view class="marketing-icon me"></view><text>我的</text></button>
  </view>
</view>
