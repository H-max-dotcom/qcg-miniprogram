.coupon-page { background: #f5f7f4; }
.coupon-intro { padding: 34rpx 28rpx; margin-top: 18rpx; background: #e6eee5; border: 1rpx solid #d9e5d7; border-radius: 24rpx; }
.coupon-eyebrow { font-size: 21rpx; color: #527360; letter-spacing: 2rpx; }
.coupon-title { margin-top: 14rpx; color: #234632; font-size: 40rpx; font-weight: 700; line-height: 1.4; }
.coupon-intro-note { margin-top: 12rpx; color: #5c7061; font-size: 23rpx; line-height: 1.7; }
.coupon-tabs { display: flex; gap: 12rpx; margin: 24rpx 0 18rpx; padding: 8rpx; border-radius: 18rpx; background: #e8eee7; }
.coupon-tab { display: flex; flex: 1; justify-content: center; align-items: center; min-height: 80rpx; border-radius: 12rpx; color: #617165; font-size: 27rpx; }
.coupon-tab.active { background: #fff; color: #245f40; font-weight: 700; box-shadow: 0 3rpx 10rpx rgba(29,59,37,.06); }
.tab-count { margin-left: 10rpx; padding: 4rpx 10rpx; border-radius: 20rpx; background: #eef3ed; font-size: 21rpx; }
.coupon-card { display: block; overflow: hidden; margin-top: 20rpx; padding: 0 0 22rpx; border: 1rpx solid #dfe7dc; border-top: 6rpx solid #618969; border-radius: 20rpx; background: #fff; }
.coupon-card .button-plain { width: auto; min-width: 180rpx; min-height: 76rpx; max-width: calc(100% - 56rpx); margin: 0 28rpx 0 auto; padding: 18rpx 26rpx; border: 1rpx solid #2c6b46; border-radius: 12rpx; background: #2c6b46; color: #fff; font-size: 25rpx; text-align: center; }
.coupon-card .button-plain[disabled] { color: #657469; background: #edf1eb; border-color: #dde5d9; }
.coupon-selected { border-color: #2c6b46; box-shadow: 0 0 0 2rpx #2c6b46; }
.coupon-inactive { border-top-color: #b6c0b3; background: #fafbf8; }
.coupon-eligibility { padding: 0 28rpx 20rpx; color: #805e3e; font-size: 24rpx; line-height: 1.5; word-break: break-all; }
.coupon-eligible { color: #256944; }
.coupon-retry .button-plain { margin-top: 16rpx; }
.coupon-hint, .coupon-clear { margin-top: 26rpx; line-height: 1.7; }
.coupon-page .empty { padding: 60rpx 28rpx; text-align: center; }
.empty-symbol { display: inline-block; padding: 18rpx 24rpx; background: #e7eee3; border: 2rpx dashed #aabd9e; border-radius: 16rpx; color: #69865a; font-size: 38rpx; }
.empty-title { margin-top: 24rpx; color: #40573e; font-size: 28rpx; font-weight: 600; }
.empty-note { margin: 14rpx 0 24rpx; font-size: 24rpx; line-height: 1.7; color: #72806e; }

.mine-status-tabs { display: flex; flex-wrap: wrap; gap: 8rpx; margin: 12rpx 0; }
.mine-status-tab { margin: 0; padding: 12rpx 18rpx; font-size: 24rpx; line-height: 1.5; color: #617165; background: transparent; border-radius: 10rpx; }
.mine-status-tab.active { color: #245f40; background: #e1ebdd; font-weight: 600; }

/* 032F: keep all status filters, with three primary chips per row. */
.mine-status-tabs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10rpx; }
.mine-status-tab { width: 100%; min-width: 0; max-width: 100%; margin: 0; padding: 16rpx 4rpx; font-size: 25rpx; line-height: 1.4; white-space: nowrap; color: #59675f; background: #edf1eb; }
.mine-status-tab.active { color: #245f40; background: #dcebdc; font-weight: 700; box-shadow: inset 0 0 0 1rpx #7b9f82; }
