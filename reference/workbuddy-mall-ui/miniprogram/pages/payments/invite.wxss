.invite-page{padding:40rpx 28rpx;min-height:100vh;background:#f5f7f4;box-sizing:border-box}.brand{color:#0f8f5f;font-size:36rpx;font-weight:700;margin:20rpx 8rpx 36rpx}.invite-card{padding:40rpx 32rpx;background:#fff;border-radius:24rpx}.title{font-size:38rpx;font-weight:600}.order-number{font-size:26rpx;color:#66716b;margin-top:28rpx;word-break:break-all}.amount{font-size:64rpx;font-weight:700;margin:32rpx 0;color:#172b22}.note{font-size:28rpx;line-height:1.65;color:#63716a;margin:24rpx 0}.pay{background:#0f8f5f;color:#fff}.success{font-size:36rpx;color:#0f8f5f;margin-top:36rpx}.message{font-size:28rpx;line-height:1.6;color:#8c5124;margin-top:24rpx}button{margin-top:24rpx}
