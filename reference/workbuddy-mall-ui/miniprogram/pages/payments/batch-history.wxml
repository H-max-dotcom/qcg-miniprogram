<view class="page history-page"><button class="button-plain" bindtap="goBack">‹ 返回</button><view class="heading">{{tab === 'PREPAID' ? '预付款支付流水' : '付款记录'}}</view>
<view wx:if="{{loading}}" class="empty">正在读取…</view><view wx:elif="{{error}}" class="card">{{error}}<button bindtap="refresh">重试</button></view>
<block wx:else><view wx:for="{{items}}" wx:key="paymentId" class="card record"><button class="record-head" data-id="{{item.paymentId}}" bindtap="toggle"><view class="amount">{{tab === 'PREPAID' && item.prepaidLedger ? '¥' + item.prepaidLedger.delta : '本次支付 ¥' + item.amount}}</view><view>{{item.statusText}} · {{item.kind === 'BATCH' ? '批量付款' : '单笔付款'}}</view><view>结清 {{item.settledCount}} 笔 · 查看明细 {{item.expanded ? '⌃' : '⌄'}}</view><view class="small">{{item.dateText}} · {{item.methodText}}</view></button>
<view wx:if="{{item.expanded}}" class="details"><view wx:for="{{item.allocations}}" wx:for-item="allocation" wx:key="receivableId" class="allocation"><view class="reference">订单 {{allocation.orderNo}}</view><view class="amount">¥{{allocation.netAmount}}</view><view class="small">应收 ¥{{allocation.grossAmount}} · 优惠 ¥{{allocation.discountAmount}}</view><view class="small">已付 ¥{{allocation.settledAmount}}</view></view><view wx:if="{{item.prepaidLedger}}" class="small">预付款余额变动 ¥{{item.prepaidLedger.delta}}</view></view></view>
<view wx:if="{{!items.length}}" class="empty">暂无付款记录</view><view class="pagination"><button wx:if="{{page > 1}}" bindtap="previousPage">上一页</button><button wx:if="{{hasMore}}" bindtap="nextPage">下一页</button></view></block></view>
