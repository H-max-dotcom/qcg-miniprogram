.address-form {
  display: grid;
  gap: 20rpx;
}

.field {
  display: grid;
  gap: 8rpx;
}

.two-column,
.region-grid {
  display: grid;
  gap: 16rpx;
}

.two-column {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.region-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.input {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
}

.address-textarea-shell {
  position: relative;
}

.address-textarea {
  height: 156rpx;
  min-height: 156rpx;
  max-height: 300rpx;
  padding: 18rpx 18rpx 46rpx;
  line-height: 1.55;
  overflow-y: auto;
}

.address-counter {
  position: absolute;
  right: 16rpx;
  bottom: 12rpx;
  z-index: 2;
  color: #8a968f;
  font-size: 22rpx;
  pointer-events: none;
}

.default-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf1ee;
}

.save-button {
  width: 100%;
  min-height: 84rpx;
  margin-top: 24rpx;
  text-align: center;
}
