.page.campaign-detail-page{padding:20rpx 24rpx calc(168rpx + env(safe-area-inset-bottom));background:#f3f8f5;min-height:100vh}
.mini-topbar{justify-content:flex-start;padding-bottom:18rpx}.mini-topbar .brand-title{font-size:32rpx;font-weight:700;color:#182b24}.mini-topbar .icon-btn{background:transparent;color:#193b2c;font-size:48rpx}
.campaign-hero{position:relative;overflow:hidden;border-radius:24rpx 24rpx 0 0;background:#e6f1eb}.campaign-cover{display:block;width:100%;height:394rpx}.campaign-cover-empty{position:relative;box-sizing:border-box;display:flex;flex-direction:column;justify-content:center;gap:20rpx;padding:48rpx 34rpx;color:#fff;background:linear-gradient(125deg,#0a4834,#138760);overflow:hidden}.hero-brand{font-size:22rpx;letter-spacing:3rpx;color:#c8ead9;z-index:1}.cover-name{max-width:88%;font-size:45rpx;line-height:1.32;font-weight:800;z-index:1}.hero-caption{font-size:25rpx;color:#e0f0de;z-index:1}.hero-orbit{position:absolute;right:-95rpx;bottom:-160rpx;width:400rpx;height:400rpx;border:55rpx solid rgba(232,247,213,.1);border-radius:50%;transform:rotate(-20deg)}.campaign-status{position:absolute;right:20rpx;top:20rpx;padding:9rpx 20rpx;background:#07885e;color:#fff;border-radius:99rpx;font-size:23rpx;font-weight:700;box-shadow:0 4rpx 16rpx rgba(0,0,0,.08)}.campaign-status.upcoming{background:#9b762a}
.campaign-summary{position:relative;margin-top:-14rpx;padding:26rpx 26rpx 28rpx;border-radius:22rpx;background:#fff}.campaign-name{display:block;font-size:36rpx;line-height:1.4;font-weight:800;color:#182b24}.campaign-description{display:block;margin-top:12rpx;color:#66736b;font-size:25rpx;line-height:1.65}.campaign-time{display:flex;align-items:flex-start;gap:12rpx;margin-top:20rpx;font-size:22rpx;color:#53645a;line-height:1.6}.time-label{flex-shrink:0;color:#087e56;background:#edf8f1;border-radius:8rpx;padding:0 8rpx;font-weight:700}
.campaign-detail-page .section{margin-top:20rpx;padding:24rpx;border:1rpx solid #eef3ef;border-radius:22rpx;background:#fff}.section-head{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin:0 0 20rpx}.section-head text:first-child{font-size:29rpx;font-weight:750;color:#21352a}.section-caption{font-size:21rpx;color:#7d8d82}.campaign-detail-page .highlights-section{background:linear-gradient(120deg,#e6f5ec,#f6fbf7)}.highlights-section .section-head text:first-child{color:#07865b}.highlight-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14rpx}.highlight{position:relative;min-width:0;padding:20rpx 16rpx;background:rgba(255,255,255,.9);border-radius:16rpx}.highlight-icon{display:flex;align-items:center;justify-content:center;width:48rpx;height:48rpx;border-radius:50%;background:#e7f5ed;color:#08885d;font-size:25rpx;font-weight:700;margin-bottom:12rpx}.highlight-title{display:block;font-size:25rpx;font-weight:700;color:#263c30}.highlight-copy{display:block;margin-top:8rpx;font-size:21rpx;line-height:1.5;color:#78877d}
.campaign-products{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18rpx}.campaign-product{min-width:0;overflow:hidden;background:#fff;border:1rpx solid #edf1eb;border-radius:16rpx;box-shadow:0 5rpx 14rpx rgba(36,68,46,.04);display:flex;flex-direction:column}.product-visual{position:relative;background:#f9faf7}.product-image{display:block;width:100%;height:272rpx;background:#fafbf8}.product-image-fallback{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12rpx;color:#a2b0a5;font-size:19rpx}.product-image-fallback{background:linear-gradient(145deg,#f5f8f5,#edf3ee);color:#9aa99f;font-size:20rpx}.fallback-mark{display:flex;align-items:center;justify-content:center;width:74rpx;height:74rpx;border:2rpx solid #dbe7df;border-radius:22rpx;color:#a4baab;font-size:36rpx;font-weight:500}.product-benefit{position:absolute;bottom:10rpx;left:10rpx;border-radius:7rpx;padding:5rpx 10rpx;background:#fff0df;color:#a85b26;font-size:20rpx}.product-copy{padding:16rpx;display:flex;flex-direction:column;flex:1;min-width:0}.product-name{font-size:26rpx;font-weight:650;color:#233a2c;line-height:1.5;min-height:78rpx;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.spec{font-size:22rpx;line-height:1.5;color:#7a877d;margin:8rpx 0 18rpx;word-break:break-all}.price-facts{margin-top:auto}.price-label{display:block;font-size:20rpx;color:#849086;margin-bottom:4rpx}.price-line{display:flex;flex-wrap:nowrap;align-items:baseline;gap:6rpx;white-space:nowrap}.price-line .money{min-width:0;letter-spacing:-1rpx}.price-unit{flex-shrink:0}.money{font-size:33rpx;font-weight:750;color:#bc572b;line-height:1.4}.price-unit{font-size:20rpx;color:#8b958e}.discount-note{display:block;font-size:20rpx;color:#ac692c;margin-top:5rpx}.price-unavailable{font-size:22rpx;line-height:1.6;color:#9b723c;margin-top:auto;min-height:62rpx}.campaign-product .add-product{width:100%;min-width:0;height:72rpx;min-height:72rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin:18rpx 0 0;padding:0 4rpx;border-radius:99rpx;font-size:23rpx;line-height:1.5;background:#0b9063}.campaign-product .add-product[disabled]{background:#e8ede9;color:#96a097}
.published-rules{white-space:pre-wrap;font-size:24rpx;line-height:1.8;color:#65776a;margin-bottom:16rpx}.rule-row{display:flex;align-items:flex-start;gap:12rpx;margin-top:12rpx;font-size:23rpx;line-height:1.7;color:#718074}.rule-dot{color:#138d61;font-weight:700}.fact-row{display:flex;justify-content:space-between;gap:20rpx;font-size:23rpx;padding:12rpx 0;color:#617665}.page-signature{padding:28rpx 0 12rpx;text-align:center;font-size:21rpx;color:#9daf9f}
.campaign-bottom{position:fixed;left:0;right:0;bottom:0;z-index:36;display:flex;align-items:center;gap:14rpx;padding:16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));background:#fff;border-top:1rpx solid #e8efe9;box-sizing:border-box}.campaign-bottom button{margin:0;box-sizing:border-box;min-width:0;line-height:1.4}.campaign-bottom .share-entry{flex:0 0 180rpx;width:180rpx;height:84rpx;display:flex;align-items:center;justify-content:center;background:#edf7f1;color:#14784f;font-size:25rpx;font-weight:650;border-radius:16rpx;padding:0}.campaign-bottom .shop-entry{flex:1;height:84rpx;min-height:84rpx;font-size:29rpx;border-radius:16rpx;background:#09885e;padding:0 12rpx}.cta-arrow{padding-left:16rpx;font-size:34rpx}.campaign-bottom .cart-entry{position:relative;flex:0 0 78rpx;width:78rpx;padding:0;background:transparent;border-radius:0;overflow:visible;color:#128657;height:88rpx}.cart-entry::after{border:0}.cart-icon{position:relative;width:43rpx;height:43rpx;margin:3rpx auto 4rpx}.cart-handle{position:absolute;left:0;top:3rpx;width:11rpx;border-top:4rpx solid #128657;transform:rotate(15deg)}.cart-basket{position:absolute;left:9rpx;top:9rpx;width:28rpx;height:20rpx;border:4rpx solid #128657;border-top-width:3rpx;transform:skew(-8deg);border-radius:2rpx 2rpx 6rpx 6rpx}.cart-wheels{position:absolute;left:13rpx;bottom:0;width:6rpx;height:6rpx;border-radius:50%;background:#128657;box-shadow:20rpx 0 #128657}.cart-label{display:block;font-size:18rpx;line-height:1.4}.cart-badge{position:absolute;right:-2rpx;top:-3rpx;min-width:24rpx;padding:1rpx 5rpx;border-radius:99rpx;background:#dc523e;color:#fff;font-size:19rpx;line-height:1.4}
.state-card{padding:56rpx 28rpx;border-radius:24rpx;margin-top:22rpx;background:#fff;text-align:center}.state-brand{display:block;color:#10845a;font-size:23rpx;margin-bottom:24rpx}.ended-title{display:block;font-size:36rpx;font-weight:750;color:#2c4234}.ended-copy{display:block;font-size:25rpx;line-height:1.8;color:#758478;margin-top:16rpx}.ended-actions{display:flex;flex-wrap:wrap;justify-content:center;gap:16rpx;margin-top:30rpx}.state-action{margin:24rpx 10rpx 0}.campaign-share-panel{position:fixed;left:24rpx;right:24rpx;bottom:calc(134rpx + env(safe-area-inset-bottom));z-index:40;box-shadow:0 8rpx 40rpx rgba(17,44,29,.18)}.campaign-share-actions{display:flex;gap:14rpx;margin-bottom:18rpx}.campaign-share-actions button{flex:1;min-width:0;font-size:25rpx;padding:0 10rpx}
@media (max-width:350px){.campaign-bottom .share-entry{flex-basis:160rpx;width:160rpx;font-size:24rpx}.section-caption{font-size:19rpx}.campaign-detail-page .section{padding:20rpx}.product-copy{padding:13rpx}.money{font-size:30rpx}.product-name{font-size:25rpx}}

.campaign-product-wide{grid-column:1 / -1;flex-direction:row;align-items:stretch}.campaign-product-wide .product-visual{flex:0 0 43%;width:43%;display:flex;align-items:center}.campaign-product-wide .product-image{height:272rpx}.campaign-product-wide .product-copy{padding:20rpx}.campaign-product-wide .product-name{min-height:0}.campaign-product-wide .price-facts{margin-top:auto;padding-top:4rpx}.campaign-product-wide .spec{margin-bottom:12rpx}.campaign-product-wide .add-product{margin-top:14rpx}.eligibility-note{font-size:23rpx;line-height:1.7;color:#718074;margin-bottom:12rpx}
