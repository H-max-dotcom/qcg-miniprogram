<view class="page no-tab campaigns-page">
  <view class="mini-topbar">
    <button class="icon-btn" bindtap="goBack">‹</button>
    <view class="brand">
      <text class="brand-title">活动中心</text>
      <text class="brand-subtitle">精选好货 · 采购优惠</text>
    </view>
  </view>

  <view class="loading" wx:if="{{viewState === 'LOADING'}}">活动加载中…</view>

  <view class="error-state" wx:if="{{viewState === 'ERROR'}}">
    <view>{{errorMessage}}</view>
    <button class="button-primary state-action" bindtap="retry">重新加载</button>
  </view>

  <view class="empty" wx:if="{{viewState === 'EMPTY'}}">
    <view class="empty-title">暂无进行中的活动</view>
    <view>有适合您的活动时，会在这里展示。</view>
  </view>

  <view class="campaign-list" wx:if="{{viewState === 'READY'}}">
    <button
      class="campaign-card"
      wx:for="{{campaigns}}"
      wx:key="code"
      data-code="{{item.code}}"
      bindtap="openCampaign"
    >
      <image wx:if="{{item.heroImageUrl && !item.heroFailed}}" class="campaign-cover campaign-original-poster" src="{{item.heroImageUrl}}" mode="widthFix" lazy-load="true" data-code="{{item.code}}" data-src="{{item.heroImageUrl}}" binderror="heroImageError" /><view wx:else class="campaign-cover campaign-cover-empty"><text>{{item.heroFailed ? '活动海报暂不可用' : '活动海报暂未上传'}}</text><text class="cover-name">{{item.name}}</text></view>
      <view class="campaign-card-head">
        <text class="campaign-title">{{item.name}}</text>
        <text class="tag {{item.state === 'ACTIVE' ? '' : item.state === 'UPCOMING' ? 'orange' : 'gray'}}">{{item.stateText}}</text>
      </view>
      <text class="campaign-description">{{item.marketingSubtitle || item.customerCopy || item.description}}</text>
      <view class="campaign-fact"><text>活动时间</text><text>{{item.timeText}}</text></view>
      <view class="campaign-fact"><text>参与资格</text><text>{{item.eligibilityText}}</text></view>
      <view class="campaign-fact" wx:if="{{item.showPrepaidInformation}}"><text>预存要求</text><text>{{item.prepaidRequirementText}}</text></view>
      <view class="campaign-action">立即参加 <text>›</text></view>
    </button>
  </view>
</view>
