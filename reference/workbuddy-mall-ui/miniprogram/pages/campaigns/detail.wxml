<view class="page no-tab campaign-detail-page">
  <view class="mini-topbar"><button class="icon-btn" bindtap="goBack" aria-label="返回">‹</button><view class="brand"><text class="brand-title">活动详情</text></view></view>
  <view class="loading" wx:if="{{viewState === 'LOADING'}}">活动详情加载中…</view>
  <view class="error-state state-card" wx:if="{{viewState === 'ERROR'}}"><text class="state-brand">全渠供 · 商城活动</text><text class="ended-title">{{needsLogin ? '登录后查看您的商城价格' : '活动暂不可用'}}</text><view class="ended-copy">{{errorMessage}}</view><button wx:if="{{needsLogin}}" class="button-primary state-action" bindtap="continueAfterLogin">登录 / 绑定客户</button><button wx:elif="{{!invalidContent}}" class="button-primary state-action" bindtap="retry">重新加载</button><button class="button-plain state-action" bindtap="goHome">返回商城</button></view>
  <view class="ended-state state-card" wx:if="{{viewState === 'UPCOMING'}}"><text class="state-brand">全渠供 · 商城活动</text><text class="ended-title">活动即将开始</text><text class="ended-copy">{{errorMessage}}</text><view class="ended-actions"><button class="button-primary" bindtap="goHome">返回商城</button></view></view>
  <view class="ended-state state-card" wx:if="{{viewState === 'ENDED'}}"><text class="state-brand">全渠供 · 商城活动</text><text class="ended-title">活动已结束</text><text class="ended-copy">本期活动已结束，不再享受本期活动优惠。</text><text class="ended-copy">看看商城其他采购活动吧。</text><view class="ended-actions"><button class="button-primary" bindtap="goActivities">查看其他活动</button><button class="button-plain" bindtap="goHome">返回商城</button></view></view>
  <block wx:if="{{viewState === 'READY'}}">
    <view class="campaign-hero">
      <image wx:if="{{campaign.detailHeroUrl && !heroFailed}}" class="campaign-cover" src="{{campaign.detailHeroUrl}}" mode="aspectFill" binderror="heroImageError" />
      <view wx:else class="campaign-cover campaign-cover-empty"><text class="hero-brand">全渠供 QUANQUGONG</text><text class="cover-name">{{campaign.name}}</text><text class="hero-caption">精选商品 · 便捷采购</text><view class="hero-orbit"></view></view>
      <text class="campaign-status {{campaign.state === 'UPCOMING' ? 'upcoming' : ''}}">{{campaign.state === 'ACTIVE' ? '进行中' : campaign.state === 'UPCOMING' ? '即将开始' : campaign.stateText}}</text>
    </view>
    <view class="campaign-summary"><text class="campaign-name">{{campaign.name}}</text><text wx:if="{{campaign.marketingSubtitle || campaign.customerCopy || campaign.description}}" class="campaign-description">{{campaign.marketingSubtitle || campaign.customerCopy || campaign.description}}</text><view class="campaign-time"><text class="time-label">活动时间</text><text>{{campaign.timeText}}</text></view></view>
    <view class="section highlights-section"><view class="section-head"><text>活动亮点</text><text class="section-caption">为日常采购多一份方便</text></view><view class="highlight-grid"><view class="highlight"><text class="highlight-icon">价</text><text class="highlight-title">您的商城价格</text><text class="highlight-copy">登录后查看专属价格</text></view><view class="highlight"><text class="highlight-icon">购</text><text class="highlight-title">按需选购</text><text class="highlight-copy">选好规格，加入购物车</text></view></view></view>
    <view id="campaign-products" class="section products-section"><view class="section-head"><text>活动商品</text><text class="section-caption">{{campaign.products.length}}款可选</text></view><view class="empty" wx:if="{{campaign.emptyProducts}}">当前活动暂无可展示商品</view><view class="campaign-products" wx:else>
      <view class="campaign-product {{item.isWideCard ? 'campaign-product-wide' : ''}}" wx:for="{{campaign.products}}" wx:key="productUnitId"><view class="product-visual" data-product-id="{{item.productId}}" bindtap="viewProduct"><image wx:if="{{item.imageUrl && !item.imageFailed}}" class="product-image" src="{{item.imageUrl}}" mode="aspectFit" lazy-load="true" data-unit-id="{{item.productUnitId}}" binderror="productImageError" /><view wx:else class="product-image product-image-fallback"><view class="fallback-mark">供</view><text>全渠供商城</text></view><text class="product-benefit" wx:if="{{item.campaignEligible}}">活动优惠</text></view><view class="product-copy"><text class="product-name" data-product-id="{{item.productId}}" bindtap="viewProduct">{{item.name}}</text><text class="spec">{{item.spec}}{{item.spec !== item.unitName ? ' / ' + item.unitName : ''}}</text><view class="price-facts" wx:if="{{item.pricingStatus === 'AVAILABLE'}}"><text class="price-label">您的商城价</text><view class="price-line"><text class="money">{{item.finalUnitPriceText}}</text><text class="price-unit">/ {{item.unitName}}</text></view></view><view class="price-unavailable" wx:else>当前价格暂不可用</view><text wx:if="{{item.campaignEligible && item.savedAmount > 0}}" class="discount-note">本次已省 {{item.savedAmountText}}</text><button class="button-primary add-product" disabled="{{!item.canAddToCart || item.pricingStatus !== 'AVAILABLE' || campaign.state !== 'ACTIVE'}}" data-unit-id="{{item.productUnitId}}" bindtap="addProduct">加入购物车</button></view></view>
    </view></view>
    <view class="section rules-section"><view class="section-head"><text>活动说明</text></view><view class="eligibility-note" wx:if="{{campaign.eligibilityText}}">{{campaign.eligibilityText}}</view><view class="published-rules" wx:if="{{campaign.campaignRulesText}}">{{campaign.campaignRulesText}}</view><view class="fact-row" wx:if="{{campaign.showPrepaidInformation}}"><text>预存要求</text><text>{{campaign.prepaidRequirementText}}</text></view><view class="fact-row" wx:if="{{campaign.showPrepaidInformation}}"><text>可用余额</text><text>{{campaign.currentAvailableBalanceText}}</text></view><view class="rule-row" wx:for="{{campaign.customerRules}}" wx:key="index"><text class="rule-dot">•</text><text>{{item}}</text></view></view>
    <view class="page-signature">全渠供 · 让采购更简单</view>
    <view class="campaign-share-panel section" wx:if="{{sharePanelOpen && canShare}}"><view class="section-head"><text>分享活动</text><button class="button-plain" bindtap="closeSharePanel">收起</button></view><view class="campaign-share-actions"><button wx:if="{{shareReady}}" class="button-primary" open-type="share">发送给好友</button><button wx:else class="button-primary" bindtap="openSharePanel" loading="{{sharing}}" disabled="{{sharing}}">{{sharing ? '准备分享中' : '重新准备分享'}}</button><button class="button-plain" bindtap="showTimelineGuide" disabled="{{!shareReady}}">分享到朋友圈</button></view><text class="warning" wx:if="{{shareError}}">{{shareError}}</text><text class="small">朋友圈分享请使用右上角“…”菜单</text></view>
    <view class="campaign-bottom"><button wx:if="{{canShare}}" class="share-entry" bindtap="openSharePanel">分享活动</button><button class="shop-entry button-primary" bindtap="shopCampaign" disabled="{{campaign.emptyProducts}}">立即选购 <text class="cta-arrow">→</text></button><button class="cart-entry" bindtap="goCart" aria-label="购物车，{{cartCount}}件商品"><view class="cart-icon"><view class="cart-handle"></view><view class="cart-basket"></view><view class="cart-wheels"></view></view><text class="cart-badge" wx:if="{{cartCount}}">{{cartCount > 99 ? '99+' : cartCount}}</text><text class="cart-label">购物车</text></button></view>
  </block>
</view>
