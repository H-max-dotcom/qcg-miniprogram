.auth-root {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  overflow: hidden;
  z-index: 1000;
}

.auth-mask {
  position: absolute;
  inset: 0;
  background: rgba(17, 24, 19, 0.46);
}

.auth-sheet {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  left: 0;
  right: 0;
  bottom: 0;
  box-sizing: border-box;
  width: 100%;
  max-height: 92%;
  overflow-y: auto;
  padding-top: 16rpx;
  padding-right: 32rpx;
  padding-bottom: calc(28rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  padding-left: 32rpx;
  border-radius: 32rpx 32rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -8rpx 32rpx rgba(18, 31, 24, 0.12);
}

.auth-handle {
  width: 64rpx;
  height: 6rpx;
  margin: 0 auto 14rpx;
  border-radius: 999rpx;
  background: #d8dedb;
}

.auth-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 64rpx;
}

.auth-title {
  flex: 1;
  min-width: 0;
  color: #18211c;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.3;
  text-align: left;
}

.auth-close {
  display: flex;
  flex: 0 0 64rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 64rpx;
  min-width: 64rpx;
  height: 64rpx;
  min-height: 64rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: transparent;
  color: #657169;
  font-size: 42rpx;
  font-weight: 300;
  line-height: 1;
  text-align: center;
}

.auth-close--hover {
  background: #f1f6f3;
}

.auth-close--disabled {
  opacity: 0.45;
}

.auth-brand-area {
  width: 100%;
  padding: 22rpx 0 4rpx;
  text-align: center;
}

.auth-brand {
  color: #18211c;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.3;
  text-align: center;
}

.auth-value {
  margin: 14rpx auto 0;
  color: #738078;
  font-size: 26rpx;
  line-height: 1.5;
  text-align: center;
}

.auth-value-line {
  display: block;
}

.auth-login-boundary {
  display: flex;
  align-items: stretch;
  width: 100%;
  margin-top: 32rpx;
}

.auth-login {
  flex: 1 1 100%;
  align-self: stretch;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  max-width: none;
  margin-top: 0;
  margin-right: 0;
  margin-left: 0;
  padding: 0;
  height: 88rpx;
  min-height: 88rpx;
  line-height: normal;
  border-radius: 16rpx;
  background: #07c160;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
}

.auth-login--disabled {
  background: #d7e0db;
  color: #748078;
  opacity: 1;
}

.auth-login--pending {
  background: #06a551;
  color: #ffffff;
  opacity: 1;
}

.auth-login.auth-login--pending {
  background: #06a551;
  color: #ffffff;
  opacity: 1;
}

.auth-login--hover {
  background: #06ad56;
}

.auth-login-content {
  box-sizing: border-box;
  display: grid;
  grid-template-columns: 32rpx minmax(0, 1fr) 32rpx;
  align-items: center;
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
}

.auth-login-spinner-slot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
}

.auth-login-spinner {
  box-sizing: border-box;
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.45);
  border-top-color: #ffffff;
  border-radius: 50%;
  opacity: 0;
}

.auth-login-spinner--visible {
  opacity: 1;
  animation: auth-login-spin 0.8s linear infinite;
}

.auth-login-text {
  min-width: 0;
  line-height: 1;
  text-align: center;
  white-space: nowrap;
}

.auth-privacy {
  display: grid;
  grid-template-columns: 44rpx minmax(0, 1fr);
  column-gap: 12rpx;
  align-items: flex-start;
  box-sizing: border-box;
  width: 100%;
  margin-top: 20rpx;
}

.auth-checkbox-group {
  display: block;
  box-sizing: border-box;
  width: 44rpx;
  min-width: 44rpx;
  height: 44rpx;
}

.auth-checkbox-hit {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  box-sizing: border-box;
  width: 44rpx;
  height: 44rpx;
  min-height: 44rpx;
  margin: 0;
  padding: 0;
}

.auth-checkbox-control {
  position: absolute;
  inset: 0;
  box-sizing: border-box;
  width: 44rpx;
  min-width: 44rpx;
  height: 44rpx;
  margin: 0;
  padding: 0;
  opacity: 0;
  z-index: 1;
}

.auth-checkbox-visual {
  box-sizing: border-box;
  display: flex;
  flex: 0 0 32rpx;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  margin: 0;
  border: 2rpx solid #aeb9b2;
  border-radius: 6rpx;
  background: #ffffff;
  color: #ffffff;
  pointer-events: none;
}

.auth-checkbox-visual--checked {
  border-color: #07c160;
  background: #07c160;
}

.auth-checkbox-check {
  color: inherit;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
}

.auth-privacy-copy {
  flex: 1;
  min-width: 0;
  padding-top: 4rpx;
  color: #5f6c64;
  font-size: 24rpx;
  line-height: 36rpx;
  text-align: left;
  word-break: normal;
  overflow-wrap: break-word;
}

.auth-privacy-link {
  color: #078a49;
  font-weight: 600;
}

.auth-privacy-link--disabled {
  opacity: 0.55;
}

.auth-error {
  box-sizing: border-box;
  width: 100%;
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: #fff4f0;
  color: #b3472f;
  font-size: 24rpx;
  line-height: 1.45;
}

.auth-login::after,
.auth-close::after {
  border: none;
}

@media (max-width: 320px) {
  .auth-sheet {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }
}

@keyframes auth-login-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}
