:host {
  position: relative;
  z-index: 1;
  display: block;
  width: 72rpx;
  height: 72rpx;
  overflow: visible;
}

.cart-entry {
  position: relative;
  z-index: 1;
  display: flex;
  flex: 0 0 72rpx;
  align-items: center;
  align-self: center;
  justify-content: center;
  justify-self: center;
  width: 72rpx;
  min-width: 72rpx;
  max-width: 72rpx;
  height: 72rpx;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  line-height: 1;
  overflow: visible;
  box-sizing: border-box;
}

.cart-entry::after {
  border: 0;
}

.cart-icon-shell {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 46rpx;
  height: 46rpx;
  border-radius: 14rpx;
  background: #e9f6ef;
  color: #0f8f5f;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1;
  overflow: hidden;
  box-sizing: border-box;
}

.cart-entry--selected .cart-icon-shell {
  box-shadow: 0 0 0 2rpx rgba(15, 143, 95, 0.12);
}

.cart-badge {
  position: absolute;
  /* Keep the badge inside the native button bounds; overflow is clipped in WeChat. */
  top: 0;
  right: 0;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 7rpx;
  border: 2rpx solid #ffffff;
  border-radius: 999rpx;
  background: #e54832;
  color: #ffffff;
  font-size: 19rpx;
  font-weight: 800;
  line-height: 32rpx;
  white-space: nowrap;
  pointer-events: none;
  box-sizing: border-box;
}
