.detail-cover {
  position: relative;
  width: 100%;
  height: 702rpx;
  box-sizing: border-box;
  overflow: hidden;
  border: 1rpx solid #dbe9df;
  border-radius: 24rpx;
  background: linear-gradient(145deg, #eef8f2, #e4f3ea);
  color: #0f8f5f;
  font-size: 80rpx;
  font-weight: 800;
}

.detail-cover-empty {
  height: 260rpx;
}

.detail-cover-swiper {
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
  overflow: hidden;
}

.detail-cover-swiper swiper-item {
  width: 100%;
  height: 100%;
}

.detail-cover-image {
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
  display: block;
}

.detail-image-loading {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: linear-gradient(145deg, #eef8f2, #e4f3ea);
  color: #648071;
  font-size: 24rpx;
  font-weight: 700;
  pointer-events: none;
}

.detail-image-count {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  z-index: 2;
  min-width: 64rpx;
  padding: 7rpx 13rpx;
  border-radius: 999rpx;
  background: rgba(23, 35, 28, .68);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
}

.detail-product-placeholder {
  width: 100%;
  height: 100%;
  display: grid;
  place-content: center;
  justify-items: center;
  gap: 14rpx;
  color: #648071;
  font-size: 25rpx;
  font-weight: 700;
}

.detail-placeholder-pack {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 116rpx;
  height: 138rpx;
  border: 5rpx solid #79b596;
  border-radius: 18rpx 18rpx 26rpx 26rpx;
  background: linear-gradient(180deg, #ffffff, #dcefe5);
  color: #438264;
  font-size: 30rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.detail-placeholder-pack view {
  position: absolute;
  top: -21rpx;
  width: 62rpx;
  height: 24rpx;
  border-radius: 12rpx 12rpx 3rpx 3rpx;
  background: #79b596;
}

.product-core {
  padding: 26rpx;
}

.product-title {
  color: #17231c;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.42;
  word-break: break-word;
}

.selected-spec {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  margin-top: 14rpx;
  color: #708078;
  font-size: 23rpx;
  line-height: 1.4;
}

.selected-spec-name {
  color: #26352c;
  font-weight: 700;
}

.price-panel {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #edf1ee;
}

.price-label {
  display: block;
  margin-bottom: 6rpx;
  color: #708078;
  font-size: 22rpx;
}

.price-value {
  font-size: 44rpx;
  line-height: 1.2;
}

.price-source {
  margin-left: 12rpx;
  color: #708078;
  font-size: 21rpx;
}

.price-state {
  display: block;
  color: #8a5a13;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.45;
}

.recent-price {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 10rpx;
  color: #7d8981;
  font-size: 21rpx;
}

.compact-head {
  align-items: baseline;
}

.selection-count {
  color: #87948c;
  font-size: 21rpx;
  font-weight: 400;
}

.spec-options {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 16rpx;
}

.spec-option {
  position: relative;
  width: 100%;
  min-height: 92rpx;
  padding: 12rpx 38rpx 12rpx 16rpx;
  border: 1rpx solid #dce8df;
  border-radius: 14rpx;
  background: #ffffff;
  color: #33443a;
  display: flex;
  align-items: center;
  text-align: left;
}

.spec-option[disabled],
.spec-option.disabled {
  border-color: #e1e6e2;
  background: #fafbfa;
  color: #8d9991;
}

.spec-copy {
  display: grid;
  min-width: 0;
  gap: 2rpx;
}

.spec-primary {
  overflow: hidden;
  color: inherit;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.spec-secondary {
  overflow: hidden;
  color: #7a8780;
  font-size: 20rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.spec-option.active {
  border-color: #0f8f5f;
  background: #e9f6ef;
  color: #0f8f5f;
  box-shadow: 0 0 0 1rpx rgba(15, 143, 95, 0.08);
}

.spec-option.active .spec-secondary {
  color: #397b5e;
}

.spec-option.active.disabled {
  border-color: #e1e6e2;
  background: #fafbfa;
  color: #8d9991;
  box-shadow: none;
}

.spec-option.active.disabled .spec-secondary {
  color: #8d9991;
}

.spec-check {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  display: flex;
  width: 26rpx;
  height: 26rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #0f8f5f;
  color: #ffffff;
  font-size: 17rpx;
  font-weight: 800;
}

.spec-disabled-text {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  color: #8d5f3b;
  font-size: 18rpx;
  font-weight: 600;
}

.purchase-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #edf1ee;
}

.purchase-row > view:first-child {
  flex: 1;
  min-width: 0;
}

.purchase-label,
.quantity-hint {
  display: block;
}

.purchase-label {
  color: #26352c;
  font-size: 27rpx;
  font-weight: 700;
}

.quantity-hint,
.quantity-unit {
  color: #7a8780;
  font-size: 21rpx;
}

.quantity-unit {
  flex: 0 0 auto;
}

.inline-error {
  margin-top: 10rpx;
  color: #b24628;
  font-size: 22rpx;
  line-height: 1.4;
}

.field {
  display: grid;
  gap: 8rpx;
  margin-top: 22rpx;
}

.availability {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf1ee;
  color: #708078;
  font-size: 23rpx;
}

.availability-value {
  color: #0f704d;
  font-weight: 700;
}

.product-description {
  margin-top: 12rpx;
  color: #55635b;
  font-size: 25rpx;
  line-height: 1.7;
}

.remark-shell {
  position: relative;
  width: 100%;
}

.remark-shell .line-remark {
  height: 104rpx;
  min-height: 104rpx;
  max-height: 260rpx;
  padding: 18rpx 18rpx 48rpx;
  overflow-y: auto;
  font-size: 32rpx;
  line-height: 40rpx;
}

.remark-trigger {
  width: auto;
  min-height: 52rpx;
  padding: 0;
  color: #0f6f4b;
  font-size: 24rpx;
  text-align: left;
}

.remark-counter {
  position: absolute;
  right: 16rpx;
  bottom: 12rpx;
  z-index: 1;
  color: #98a2b3;
  font-size: 22rpx;
  line-height: 28rpx;
  pointer-events: none;
}

.remark-clear {
  position: absolute;
  left: 16rpx;
  bottom: 8rpx;
  z-index: 2;
  min-height: 36rpx;
  color: #6b776f;
  font-size: 22rpx;
}

.action-summary {
  min-width: 0;
}

.action-summary .small {
  display: block;
  overflow: hidden;
  font-size: 21rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-summary .money {
  display: block;
  margin-top: 2rpx;
  font-size: 28rpx;
}

.bottom-bar .button-primary[disabled] {
  background: #cfd8d2;
  color: #ffffff;
}

.detail-state-page {
  display: flex;
  min-height: 100vh;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.detail-state-card {
  width: 100%;
  padding: 36rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.detail-state-title {
  margin-bottom: 18rpx;
  color: #172033;
  font-size: 34rpx;
  font-weight: 700;
}

.detail-state-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.detail-state-actions button {
  flex: 1;
}

.product-title { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; overflow-wrap: anywhere; }

.product-share-panel{padding-top:20rpx}.product-share-actions{display:flex;gap:16rpx;margin-bottom:16rpx}.product-share-actions button{flex:1;min-width:0;font-size:26rpx}
