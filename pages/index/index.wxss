@import "../../components/mall/marketing-visual/icons.wxss";
.page,
.page view,
.page scroll-view,
.page button,
.page input,
.page text {
  box-sizing: border-box;
}

.page {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 100vw;
  overflow-x: hidden;
  padding: 24rpx 24rpx calc(272rpx + env(safe-area-inset-bottom));
}

.page button {
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
}

.topbar,
.search-row,
.search,
.section,
.category-grid,
.promo-list,
.product-grid {
  width: 100%;
  max-width: 100%;
}

.brand {
  flex: 1;
  min-width: 0;
}

.brand-title,
.brand-subtitle {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-page .search {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  grid-template-columns: none;
}

.home-page .search-field {
  flex: 1 1 auto;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
}

.home-page .search-input {
  flex: 1 1 auto;
  min-width: 0;
  width: auto;
}

.home-page .search .button-clear {
  flex: 0 0 44rpx;
  width: 44rpx;
  height: 54rpx;
  min-width: 44rpx;
  padding: 0;
  border: 0;
  background: transparent;
  color: #7a8b82;
  font-size: 34rpx;
  line-height: 54rpx;
  overflow: visible;
}

.home-page .search-submit,
.home-page .search .button-primary.search-submit {
  flex: 0 0 auto;
  flex-shrink: 0;
  width: auto;
  min-width: 128rpx;
  max-width: none;
  height: 56rpx;
  min-height: 56rpx;
  padding: 0 20rpx;
  margin: 0;
  overflow: visible;
  white-space: nowrap;
  line-height: 56rpx;
  font-size: 26rpx;
  text-align: center;
}

.category-tile--all {
  border-color: #b8d9c4;
  background: #f0faf3;
}

.hero-card {
  display: block;
  width: 100%;
  min-height: 0;
  height: auto;
  margin: 16rpx 0 0;
  padding: 28rpx 24rpx;
  text-align: left;
  overflow: visible;
}

.hero-card .row {
  align-items: stretch;
  gap: 18rpx;
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.hero-title {
  font-size: 38rpx;
  line-height: 1.18;
  white-space: normal;
  word-break: break-word;
}

.hero-card .small {
  display: block;
  margin-top: 12rpx;
  white-space: normal;
  word-break: break-word;
}

.hero-actions {
  flex-wrap: wrap;
}

.hero-actions .button-plain {
  min-width: 128rpx;
}

.hero-visual {
  flex: 0 0 108rpx;
  width: 108rpx;
  min-height: 160rpx;
  height: auto;
  padding: 12rpx 8rpx;
  font-size: 32rpx;
  line-height: 1.2;
  white-space: normal;
}

.section {
  overflow: hidden;
}

.section-head {
  align-items: center;
}

.section-head text:first-child {
  flex: 1;
  min-width: 0;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
}

.category-tile {
  width: 100%;
  min-width: 0;
  min-height: 0;
  height: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding: 16rpx 6rpx 12rpx;
}

.category-icon {
  flex: 0 0 auto;
}

.category-name {
  width: 100%;
  min-height: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: normal;
  word-break: break-word;
}

.promo-list {
  display: grid;
  grid-template-columns: 1fr;
  gap: 14rpx;
}

.promo-card {
  width: 100%;
  min-width: 0;
}

.promo-card .row {
  align-items: center;
  gap: 16rpx;
}

.promo-copy {
  flex: 1;
  min-width: 0;
}

.promo-card .product-name,
.promo-card .spec {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.promo-card .pic {
  flex: 0 0 88rpx;
  width: 88rpx;
  height: 88rpx;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 16rpx;
}

.mini-product {
  display: block;
  width: 100%;
  min-width: 0;
  padding: 12rpx;
  white-space: normal;
}

.mini-product > button {
  display: block;
  width: 100%;
  text-align: left;
}

.mini-product .pic {
  width: 100%;
  /* Native image needs a definite parent height; aspect-ratio alone is not a height contract. */
  height: 260rpx;
  flex: 0 0 auto;
  overflow: hidden;
}

.mini-product .product-image {
  display: block;
  width: 100%;
  min-width: 0;
  height: 260rpx;
  flex: 0 0 auto;
}

.mini-product .product-name {
  min-height: 76rpx;
  display: -webkit-box;
  overflow: hidden;
  word-break: break-word;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.mini-product .spec {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mini-product .labels {
  min-height: 44rpx;
  overflow: hidden;
}

.price-line {
  align-items: center;
}

.blank-price,
.money {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.add-btn {
  flex: 0 0 58rpx;
}

.cart-float {
  left: 24rpx;
  right: 24rpx;
  bottom: calc(112rpx + env(safe-area-inset-bottom));
  z-index: 45;
  grid-template-columns: 72rpx minmax(0, 1fr) 144rpx;
  overflow: visible;
}

.cart-float mall-cart-entry {
  position: relative;
  z-index: 46;
  overflow: visible;
}

.cart-float .button-primary {
  width: 144rpx;
  padding: 0;
}

.cart-float .product-name,
.cart-float .small {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.qcg-tabbar {
  z-index: 50;
}

.qcg-tabbar .marketing-icon{color:#7b8a80;transform:scale(.75)}
.qcg-tabbar .active .marketing-icon{color:#0b7a4f}

/* 023: formal marketing facts, compact native merchandise shelves. */
.home-page{background:linear-gradient(180deg,#e4f1e7 0,#f4f7f2 490rpx)}.home-page .topbar{padding:8rpx 2rpx 22rpx}.home-page .brand-title{font-size:38rpx;letter-spacing:3rpx;color:#175b40}.home-page .brand-subtitle{font-size:21rpx;color:#617569}.home-page .section{border-radius:24rpx;border:1rpx solid #e4ece3;padding:24rpx;margin-top:20rpx}.home-page .section-head{font-size:30rpx}.home-page .search{border:2rpx solid #227a52;border-radius:18rpx;background:#fff}.home-page .search-row{margin-bottom:20rpx}.home-page .mini-product{padding:12rpx;border:1rpx solid #e5ebe2;border-radius:18rpx;background:#fff}.home-page .mini-product .pic,.home-page .mini-product .product-image{height:224rpx;background:#fafbf8}.home-page .mini-product .product-name{font-size:25rpx;line-height:1.45;min-height:72rpx}.home-page .mini-product .spec{font-size:21rpx}.home-page .mini-product .money{font-size:30rpx}.home-page .product-grid{gap:14rpx}.product-photo-empty{font-size:22rpx;color:#89958a}.purchased-label{display:inline-block;font-size:19rpx;color:#397755;background:#edf6e8;padding:3rpx 9rpx;margin-top:8rpx;border-radius:5rpx}.category-art,.category-photo{display:flex;align-items:center;justify-content:center;width:68rpx;height:68rpx;margin-bottom:12rpx;background:#eef6ec;border-radius:20rpx}.hero-visual .marketing-icon{color:white;transform:scale(1.8)}.marketing-eyebrow{display:block!important;font-size:19rpx;color:#72816b;letter-spacing:3rpx;font-weight:400;margin-bottom:6rpx}.marketing-heading{display:block;font-size:32rpx;color:#224f38}

