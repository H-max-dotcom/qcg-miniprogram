/* ---------- 首页滚动轮播图 ---------- */
/* 素材 750x330（约 2.27:1），内容区宽 710rpx → 高度 312rpx 不变形 */
.banner-slot {
  position: relative;
  width: 100%;
  margin-bottom: 20rpx;
}

.banner-swiper {
  width: 100%;
  height: 312rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.banner-slide {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
  overflow: hidden;
  background: #e8f0ea;
}

.banner-image {
  display: block;
  width: 100%;
  height: 100%;
}

.banner-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #0b9468, #37b98c);
}

.banner-fallback-title {
  color: #fff;
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.banner-dots {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.banner-dot {
  width: 12rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.55);
  transition: width 0.2s;
}

.banner-dot--on {
  width: 28rpx;
  background: #ffffff;
}

/* ---------- 本周活动 ---------- */
.activity-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.activity-card {
  border-radius: 20rpx;
  overflow: hidden;
  background: #fff;
  border: 1rpx solid #e6ece5;
}

.activity-image {
  display: block;
  width: 100%;
  height: 200rpx;
  background: #eef5ef;
}

.activity-image--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #a9b6ae;
}

.activity-body {
  padding: 18rpx 20rpx 20rpx;
}

.activity-title {
  color: #22402f;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.activity-subtitle {
  margin-top: 6rpx;
  color: #6b7c71;
  font-size: 24rpx;
  line-height: 1.4;
}

.activity-cta {
  margin-top: 12rpx;
  color: #0b9468;
  font-size: 24rpx;
  font-weight: 700;
}

/* ---------- 会员资产模块（纯新增） ----------
   选择器全部收敛在 .member-assets 命名空间内，不改动任何既有类；
   按钮用 .member-assets 前缀是为了盖过 index.wxss 里的 `.page button`。 */
.member-assets {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  width: 100%;
  margin-top: 10rpx;
}

/* 紧跟其后的「本周活动」收掉一半上边距，两段之间不出现双倍留白。
   写在 .home-page 下（0,3,0）是为了稳过同文件的 `.home-page .section`（0,2,0）。
   注意：新版 V2 分支里 mall-quick-entry 会插在中间，这条选择器届时不会命中，
   属预期行为（V2 是另一套版式）。 */
.home-page .member-assets + .section {
  margin-top: 10rpx;
}

/* 下方两张卡片：左右并排，内容整体水平居中，上下 padding 各 16rpx */
.member-actions {
  display: flex;
  gap: 12rpx;
  width: 100%;
}

.member-action-card {
  display: flex;
  flex: 1 1 0;
  flex-direction: column;
  align-items: center;
  min-width: 0;
  padding: 16rpx 12rpx;
  border: 1rpx solid #dcefe4;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(0, 178, 106, 0.08);
  box-sizing: border-box;
}

/* 第一行：图标在左、标题在右，同一行居中 */
.member-action-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 100%;
}

/* 图标：造型照参考图（储值 = 卡片，领券 = 票券），颜色统一系统绿 #00b26a。
   纯 CSS 绘制，描边用 border + currentColor，内部线条也用 currentColor，
   所以整枚图标只有一种颜色，不需要 filter 调色，也不会残留参考图的红色。 */
.asset-icon {
  position: relative;
  box-sizing: border-box;
  border: 3rpx solid #00b26a;
  color: #00b26a;
}

.asset-icon::before,
.asset-icon::after {
  position: absolute;
  background: currentColor;
  content: "";
}

/* —— 储值：卡片（圆角矩形 + 顶部通栏横带 + 左下短横线）—— */
.asset-icon--card {
  width: 40rpx;
  height: 30rpx;
  border-radius: 6rpx;
}

/* 横带通栏：绝对定位的包含块是 padding box，left/right:0 正好顶到左右描边内侧 */
.asset-icon--card::before {
  left: 0;
  right: 0;
  top: 7rpx;
  height: 3rpx;
}

.asset-icon--card::after {
  left: 5rpx;
  bottom: 5rpx;
  width: 10rpx;
  height: 3rpx;
}

/* —— 领券：票券（圆角矩形 + 左右半圆缺口 + 中间等号）—— */
.asset-icon--ticket {
  width: 40rpx;
  height: 28rpx;
  border-radius: 4rpx;
}

.asset-icon--ticket::before,
.asset-icon--ticket::after {
  left: 50%;
  width: 13rpx;
  height: 3rpx;
  transform: translateX(-50%);
}

.asset-icon--ticket::before {
  top: 7rpx;
}

.asset-icon--ticket::after {
  top: 13rpx;
}

/* 缺口：用与卡片同色的白圆压在左右描边中线上，剪出半圆。
   圆心落在描边内侧（left: -5rpx + 半径 5rpx = 描边内沿 3rpx 处），
   图标所在的 .member-action-card 背景就是 #ffffff，所以这里用白色是安全的。 */
.asset-ticket-notch {
  position: absolute;
  top: 50%;
  width: 10rpx;
  height: 10rpx;
  margin-top: -5rpx;
  border-radius: 50%;
  background: #ffffff;
}

.asset-ticket-notch--left {
  left: -5rpx;
}

.asset-ticket-notch--right {
  right: -5rpx;
}

.member-assets .member-action-title {
  color: #1f2a24;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.3;
}

/* 副标题刻意弱化：仅作补充说明，不与主标题争视觉比重。
   字号 22 → 20rpx、颜色 #7b8a80 → #bbbbbb，配合上边距收紧，卡片整体反而更矮。 */
.member-assets .member-action-note {
  margin-top: 3rpx;
  color: #bbbbbb;
  font-size: 20rpx;
  line-height: 1.3;
}

/* 绿底白字胶囊按钮 */
.member-assets .member-action-btn {
  width: 100%;
  max-width: 180rpx;
  height: 40rpx;
  min-height: 40rpx;
  margin: 10rpx 0 0;
  padding: 0 16rpx;
  border: 0;
  border-radius: 999rpx;
  background: #00b26a;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 40rpx;
  text-align: center;
}

/* ===================================================================
   首页改版（2026-11-02）：纯样式追加层
   顶部全幅轮播（主色底 + 完整海报）→ 白色卡片内收
   =================================================================== */

/* ---- 1. 两处微调：游客提示语弱化、活动 CTA 轻量化 ---- */
.home-page .brand-subtitle {
  font-size: 18rpx;
  color: #999999;
}

.activity-cta {
  margin-top: 14rpx;
  font-size: 22rpx;
  font-weight: 500;
}

/* ---- 2. 搜索框：胶囊 + 绿描边 + 白底铺满 ---- */
.home-page .search {
  border: 2rpx solid #227a52;
  border-radius: 100px;
  background: #FFFFFF;
  padding: 0 8rpx 0 22rpx;
}

.home-page .search input,
.home-page .search-input {
  background: transparent;
  color: #333333;
}

.home-page .search-submit,
.home-page .search .button-primary.search-submit {
  border-radius: 100px;
  background: #0B7A4F;
  font-weight: 600;
}

/* ---- 3. 页面底色 + 底部不再自己留白 ---- */
.page.home-page {
  background: #E8EEF2;
  padding-bottom: 0 !important;
}

/* 首页不显示悬浮结算条：visibility 隐藏（保留尺寸，避免影响底部留白测量） */
.page.home-page .cart-float {
  visibility: hidden;
  pointer-events: none;
}

/* 内容容器撑满一屏，白卡才能一路延伸到底 */
.home-content {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 0 24rpx 0;
  box-sizing: border-box;
}

/* ---- 4. 顶部 Hero：全幅轮播 ---- */
.hero-zone {
  position: relative;
  margin: 0 -24rpx;
  background: #E8EEF2;
  overflow: hidden;
}

.hero-swiper {
  display: block;
  width: 100%;
}

/* 轮播单元：背景色取该图主色（WXML 内联），这里给品牌绿兜底 */
.hero-slide {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #0E7C52;
}

/* 完整海报（aspectFit），文字不裁；上下余量由主色背景填满 */
.hero-image {
  position: absolute;
  left: 0;
  top: 0;
  display: block;
  width: 100%;
  height: 100%;
}

.hero-fallback {
  display: flex;
  align-items: flex-end;
  width: 100%;
  height: 100%;
  padding: 0 32rpx 96rpx;
  background: linear-gradient(135deg, #0E7C52 0%, #2FAE83 100%);
  box-sizing: border-box;
}

.hero-fallback-title {
  color: #FFFFFF;
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

/* 指示点 */
.hero-dots {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 34rpx;
  z-index: 4;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.hero-dot {
  width: 12rpx;
  height: 6rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.55);
}

.hero-dot.on {
  width: 30rpx;
  background: #FFFFFF;
}

/* 自定义导航占位：压在海报上，只用于避让系统胶囊按钮 */
.hero-nav {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 5;
  background: transparent;
}

.hero-zone .home-hero-slot {
  display: block;
  width: 100%;
  height: 340rpx;
  margin: 0;
  border-radius: 0;
}

.hero-zone .hero-card {
  margin: 0;
  border-radius: 0;
}

/* 轮播与白卡之间的底色带 */
.hero-zone::after {
  display: block;
  height: 12rpx;
  background: #E8EEF2;
  content: "";
}

/* ---- 5. 白色内容卡片（内收 + 圆角） ---- */
.home-sheet {
  display: flex;
  flex: 1 1 auto;
  flex-direction: column;
  position: relative;
  margin: 0;
  padding: 20rpx 20rpx calc(124rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
  background: #FFFFFF;
  box-shadow: 0 6rpx 18rpx rgba(6, 40, 60, 0.08);
}

/* 第一行：绿色品牌名 + 搜索框 */
.sheet-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  width: 100%;
}

.sheet-brand {
  flex: 0 0 auto;
  color: #14513A;
  font-size: 42rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.sheet-head .search-row {
  flex: 1 1 auto;
  min-width: 0;
  margin: 0;
}

.sheet-head .search {
  height: 76rpx;
  min-height: 76rpx;
}

/* 第二行：门店/状态 + 游客标签 */
.sheet-sub {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
  width: 100%;
  margin: 10rpx 0 4rpx;
}

.sheet-sub .brand-subtitle {
  flex: 1;
  min-width: 0;
  font-size: 18rpx;
  line-height: 1.5;
  color: #999999;
}

.sheet-sub .tag.orange {
  flex: 0 0 auto;
  background: #FFF2E8;
  color: #E8833A;
  font-weight: 500;
}

/* 卡片内部模块：浅灰底，与白卡形成第二层 */
.home-sheet .member-action-card {
  border: 0;
  background: #F5F7F9;
  box-shadow: none;
}

.home-sheet .section {
  border: 0;
  background: #F5F7F9;
}

.home-sheet .notice-card,
.home-sheet .activity-card,
.home-sheet .mini-product {
  border: 0;
}
