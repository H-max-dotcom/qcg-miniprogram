.batch-page{padding:28rpx;background:#f5f7f4;min-height:100vh;box-sizing:border-box}.title{font-size:38rpx;font-weight:700;color:#174b35}.sub{font-size:25rpx;color:#6c7d71;margin:16rpx 0}.state{padding:60rpx 0;color:#6c7d71}.record{background:white;border-radius:18rpx;padding:26rpx;margin-top:24rpx;font-size:28rpx}.row{display:flex;justify-content:space-between;gap:20rpx;margin:14rpx 0}.total{font-size:34rpx;font-weight:700;color:#174b35;padding-top:18rpx}.record button{font-size:25rpx;background:#edf6ee;color:#0f8f5f}.error{font-size:26rpx;color:#9d542c;padding:20rpx 0}.pay{margin-top:28rpx;font-size:28rpx;background:#0f8f5f;color:white}.pay[disabled]{background:#dce7df;color:#8c9c91}.coupon-panel{position:fixed;bottom:0;left:0;right:0;max-height:75vh;overflow-y:auto;background:white;padding:28rpx;padding-bottom:calc(28rpx + env(safe-area-inset-bottom));box-shadow:0 0 0 100vh rgba(0,0,0,.35);border-radius:24rpx 24rpx 0 0}.coupon-panel button{font-size:26rpx;margin-top:18rpx}
/* Explicit sizing prevents global button reset from collapsing hit areas. */
.batch-page button{min-height:72rpx;line-height:1.5;padding:16rpx 20rpx;text-align:center;box-sizing:border-box;border-radius:12rpx;white-space:normal}
.batch-page .record button,.batch-page .coupon-panel button{width:100%;font-size:28rpx}
.batch-page .pay{width:100%;min-height:88rpx;font-size:30rpx;padding:20rpx 24rpx}
.batch-page .coupon-panel button{text-align:left}

.reference{font-size:22rpx;color:#68776e;line-height:1.6;word-break:break-all;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;word-break:break-all;line-height:1.5;margin-top:10rpx}
.record-title{font-weight:600;color:#294b39}.record-amount{color:#b65326;font-size:32rpx;font-weight:700;flex:none}.coupon-name{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;word-break:break-all;line-height:1.5;}.coupon-panel .sub{font-size:23rpx;margin:8rpx 0;color:#607165}.batch-page .coupon-panel{box-sizing:border-box;z-index:50}
