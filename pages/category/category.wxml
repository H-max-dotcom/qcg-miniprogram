<!-- 商品卡片模板：分区模式与单区结果列表共用，避免两处结构漂移 -->
<template name="tpl-product-card">
  <view class="product-card" data-id="{{item.productId}}" data-section-index="{{sectionIndex}}" bindtap="goProduct" hover-class="product-card--pressed" aria-label="查看商品详情：{{item.name}}">
    <view class="product-row">
      <view class="product-thumb">
        <image wx:if="{{item.imageUrl && !item.imageFailed}}" class="product-thumb-image" src="{{item.imageUrl}}" mode="aspectFill" lazy-load="true" data-id="{{item.productId}}" data-section-index="{{sectionIndex}}" binderror="onImageError" />
        <image wx:else class="product-thumb-image" src="/assets/product-placeholder.png" mode="aspectFit" />
      </view>
      <view class="product-info">
        <view class="product-name">{{item.name}}</view>
        <view class="unit-summary">
          <view class="unit-summary-copy">
            <text class="unit-primary">{{item.requiresSpecSelection ? item.spec : item.unitDisplayText}}</text>
            <text class="unit-secondary">{{item.requiresSpecSelection ? '进入详情选择规格和数量' : item.compactMetaText}}</text>
          </view>
          <text class="unit-chevron">›</text>
        </view>
        <!-- 状态与价格文案相同时不重复展示，避免出现两条一模一样的灰字 -->
        <view class="status-line" wx:if="{{item.primaryStatusText !== item.priceUnavailableText}}"><text class="status-tag {{item.canAddToCart ? 'ready' : 'neutral'}}">{{item.primaryStatusText}}</text></view>
        <view class="product-action-row">
          <view class="price-copy">
            <view wx:if="{{item.priceVisible && customerCanViewPrice}}" class="price-line"><text class="money">{{item.priceText}}</text><text class="price-unit">{{item.priceUnitText}}</text></view>
            <text wx:elif="{{customerMode === 'RESOLVING'}}" class="blank-price">客户状态确认中</text>
            <text wx:elif="{{item.requiresSpecSelection}}" class="blank-price">选单位后看价</text>
            <text wx:else class="blank-price">{{item.priceUnavailableText}}</text>
          </view>
          <button class="detail-btn" aria-label="进入商品详情" data-id="{{item.productId}}" catchtap="goProduct" hover-class="detail-btn--pressed"><text class="detail-btn-face">＋</text></button>
        </view>
      </view>
    </view>
  </view>
</template>

<view class="page category-page">
  <!-- 顶部固定区：返回栏 + 客户态提示 + 搜索。不参与滚动 -->
  <view class="category-header">
    <view class="mini-topbar">
      <button class="icon-btn" bindtap="goHome">‹</button>
      <view class="brand">
        <text class="brand-title" style="font-size: 34rpx;">分类采购</text>
        <text class="brand-subtitle">{{customerMode === 'RESOLVING' ? '正在确认客户状态' : customerMode === 'BOUND' ? '可以下单' : customerMode === 'VIEW_ONLY' ? '当前账号仅可浏览' : '登录后查看价格'}}</text>
      </view>
      <button class="icon-btn filter-trigger {{activeBrand || activeSort !== 'default' ? 'active' : ''}}" bindtap="openFilter">筛</button>
    </view>

    <view class="empty" wx:if="{{customerLoadError}}">
      <view>{{customerLoadError}}</view>
      <button class="button-plain" bindtap="retryCustomerState">重新确认客户状态</button>
    </view>
    <view class="empty" wx:if="{{categoryLoadError}}">
      <view>{{categoryLoadError}}</view>
      <button class="button-plain" bindtap="retryCategories">重新加载分类</button>
    </view>
    <view class="search-row">
      <view class="search">
        <view class="search-icon" aria-hidden="true"></view>
        <input placeholder="搜索商品 / 规格 / 条码 / 品牌" value="{{keyword}}" bindinput="inputKeyword" confirm-type="search" bindconfirm="search" />
        <button wx:if="{{keyword}}" class="button-clear" catchtap="clearKeyword">×</button>
        <button class="button-primary" bindtap="search">搜索</button>
      </view>
    </view>
  </view>

  <view class="category-layout">
    <!-- 左栏：定宽 180rpx，自身独立滚动，图标 + 文字结构 -->
    <scroll-view scroll-y="true" class="side-cats" scroll-into-view="{{activeSideId}}" scroll-with-animation="true">
      <view class="side-category-group" wx:for="{{categories}}" wx:key="id" id="cat-{{item.id || 'all'}}">
        <view class="category-item {{item.active ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectCategory">
          <!-- 分类图标：后端分类图 → 名称映射图标 → icon-default 兜底，三级都失败才退文字首字 -->
          <view class="category-icon-wrap">
            <image wx:if="{{!item.iconFailed}}" class="category-icon" src="{{item.iconPath}}" mode="aspectFit" lazy-load="true" data-name="{{item.name}}" binderror="onCategoryIconError" />
            <text wx:else class="category-initial">{{item.imageFallbackText}}</text>
          </view>
          <!-- 分类文字（不再显示「一级」字样） -->
          <text class="category-name">{{item.name}}</text>
          <text wx:if="{{item.badge}}" class="side-cat-badge">{{item.badge}}</text>
        </view>
        <view wx:if="{{item.id && activeRootCategoryId === item.id && subcategories.length}}" class="side-subcats">
          <text class="side-subcats-title">二级分类</text>
          <button class="side-subcat {{!activeSubcategoryId ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectCategory">本区全部</button>
          <button class="side-subcat {{activeSubcategoryId === child.id ? 'active' : ''}}" wx:for="{{subcategories}}" wx:for-item="child" wx:key="id" data-id="{{child.id}}" bindtap="selectSubcategory">{{child.name}}</button>
        </view>
      </view>
    </scroll-view>

    <!-- 右栏：工具栏固定，商品区独立滚动（高度由 flex 按视口算，再由 JS 实测回写） -->
    <view class="product-pane">
      <view class="catalog-summary">
        <text class="catalog-title">{{activeCategoryPath}}</text>
        <!-- 分区模式下 total 代表当前分区已加载件数；首屏未加载时先不显示计数 -->
        <text class="catalog-count" wx:if="{{singleMode || total}}">{{singleMode ? products.length : total}} 件{{activeBrand ? ' · ' + activeBrand : ''}}{{activeSort === 'sales' ? ' · 销量' : activeSort === 'latest' ? ' · 最新' : ''}}</text>
      </view>
      <scroll-view scroll-x="true" enhanced="true" show-scrollbar="false" class="catalog-toolbar">
        <view class="catalog-toolbar-inner">
          <button class="catalog-chip brand-chip {{activeBrand ? 'active' : ''}}" catchtap="openFilter">
            <text class="catalog-chip-label">{{activeBrand || '全部品牌'}}</text>
            <text class="catalog-chip-chevron">⌄</text>
          </button>
          <button class="catalog-chip {{activeSort === 'default' ? 'active' : ''}}" data-sort="default" catchtap="selectSort">默认排序</button>
          <button class="catalog-chip {{activeSort === 'sales' ? 'active' : ''}}" data-sort="sales" catchtap="selectSort">销量</button>
          <button class="catalog-chip {{activeSort === 'latest' ? 'active' : ''}}" data-sort="latest" catchtap="selectSort">最新</button>
        </view>
      </scroll-view>

      <scroll-view
        scroll-y="true"
        class="pane-scroll"
        style="{{paneHeight ? 'height:' + paneHeight + 'px;' : ''}}"
        scroll-into-view="{{paneIntoView}}"
        scroll-with-animation="{{paneAnimating}}"
        bindscroll="onPaneScroll"
        enhanced="true"
        show-scrollbar="{{false}}"
      >
        <view class="pane-inner">
          <!-- 右栏顶部锚点：单区结果列表切换后用它把滚动位置收回顶部 -->
          <view id="pane-top" class="pane-top"></view>
          <!-- 模式一：单区结果列表（搜索 / 品牌 / 排序 / 二级分类命中时） -->
          <block wx:if="{{singleMode}}">
            <view class="empty" wx:if="{{customerMode === 'RESOLVING'}}">正在确认客户状态…</view>
            <view class="empty" wx:elif="{{customerLoadError}}">客户状态暂不可用，确认后再加载商品。</view>
            <view class="empty" wx:elif="{{loading}}">商品加载中...</view>
            <view class="empty" wx:elif="{{productLoadError}}">
              <view>{{productLoadError}}</view>
              <button class="button-plain" bindtap="retryProducts">{{failedProductPage > 1 ? '重试加载更多' : '重新加载商品'}}</button>
            </view>
            <view class="empty empty-state" wx:elif="{{products.length === 0}}">
              <view class="empty-title">暂无商品</view>
              <view class="empty-desc">{{keyword ? '没有找到匹配商品，可修改关键词或筛选条件' : '可以看看其他分类'}}</view>
            </view>
            <block wx:else>
              <template wx:for="{{products}}" wx:key="lineKey" is="tpl-product-card" data="{{item: item, customerMode: customerMode, customerCanViewPrice: customerCanViewPrice}}" />
              <button class="load-more-button" wx:if="{{hasNextPage}}" bindtap="loadMore">继续加载商品</button>
              <view class="empty" wx:else>已显示全部 {{total}} 个商品</view>
            </block>
          </block>

          <!-- 模式二：分区联动列表（默认） -->
          <block wx:else>
            <view class="section" wx:for="{{sections}}" wx:key="anchor" wx:for-item="section" wx:for-index="sectionIndex" id="{{section.anchor}}">
              <view class="section-head">
                <text class="section-title">{{section.name}}</text>
                <text class="section-count">{{section.products.length}}{{section.total > section.products.length ? ' / ' + section.total : ''}} 件</text>
              </view>

              <block wx:if="{{section.status === 'ready'}}">
                <view class="section-state" wx:if="{{!section.products.length}}">该分类暂无商品</view>
                <block wx:elif="{{section.subGroups.length}}">
                  <!-- 有二级分类：按二级分组，每组一个小标题 + 该组商品。
                       组 id = sub-sec-一级id-二级id，左栏点二级时 scroll-into-view 定位到它。
                       注意：小标题不能做 sticky，吸顶后位置量不准，二级联动会算错。 -->
                  <view class="sub-section" wx:for="{{section.subGroups}}" wx:for-item="group" wx:key="key" id="{{group.anchor}}">
                    <view class="sub-section-head">
                      <text class="sub-section-title">{{group.name}}</text>
                      <text class="sub-section-count">{{group.products.length}} 件</text>
                    </view>
                    <view class="sub-section-empty" wx:if="{{!group.products.length}}">该二级分类暂无商品</view>
                    <block wx:else>
                      <template wx:for="{{group.products}}" wx:for-item="item" wx:key="lineKey" is="tpl-product-card" data="{{item: item, sectionIndex: sectionIndex, customerMode: customerMode, customerCanViewPrice: customerCanViewPrice}}" />
                    </block>
                  </view>
                </block>
                <block wx:else>
                  <!-- 没有二级分类：沿用原来的扁平列表 -->
                  <template wx:for="{{section.products}}" wx:for-item="item" wx:key="lineKey" is="tpl-product-card" data="{{item: item, sectionIndex: sectionIndex, customerMode: customerMode, customerCanViewPrice: customerCanViewPrice}}" />
                </block>

                <!-- 分区尾部：加载更多 / 已全部显示（分区内商品为空时不显示尾部） -->
                <block wx:if="{{section.products.length}}">
                  <button class="load-more-button" wx:if="{{section.hasNextPage}}" data-index="{{sectionIndex}}" bindtap="loadMoreSection">{{section.loadingMore ? '加载中…' : '加载更多'}}</button>
                  <view class="section-state section-state--tail" wx:else>已显示全部 {{section.total}} 个商品</view>
                </block>
              </block>

              <view class="section-state" wx:elif="{{section.status === 'loading'}}">商品加载中...</view>
              <view class="section-state section-state--error" wx:elif="{{section.status === 'error'}}">
                <view>{{section.error}}</view>
                <button class="button-plain" data-index="{{sectionIndex}}" bindtap="retrySection">重新加载</button>
              </view>
              <view class="section-error" wx:if="{{section.status === 'ready' && section.error}}">{{section.error}}</view>
            </view>

            <view class="empty" wx:if="{{customerLoadError}}">客户状态暂不可用，确认后再加载商品。</view>
            <view class="empty" wx:if="{{!sections.length}}">暂无分类</view>
          </block>
        </view>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{filterPanelOpen}}" class="filter-mask" catchtap="closeFilter" catchtouchmove="stopBubble">
    <view class="filter-sheet" catchtap="stopBubble" catchtouchmove="stopBubble">
      <view class="filter-sheet-head">
        <view class="filter-heading-copy">
          <text class="filter-title">筛选商品</text>
          <text class="filter-subtitle">品牌和排序统一在这里设置</text>
        </view>
        <button class="filter-close" aria-label="关闭筛选" catchtap="closeFilter"><view class="filter-close-face">×</view></button>
      </view>
      <view class="filter-body">
        <view class="filter-section filter-brand-section">
          <text class="filter-section-title">品牌</text>
          <scroll-view scroll-y="true" class="filter-brand-scroll">
            <view class="filter-options">
              <button class="filter-option {{!draftBrand ? 'active' : ''}}" data-brand="" catchtap="selectDraftBrand">全部品牌</button>
              <button class="filter-option {{draftBrand === item ? 'active' : ''}}" wx:for="{{brands}}" wx:key="*this" data-brand="{{item}}" catchtap="selectDraftBrand">{{item}}</button>
            </view>
          </scroll-view>
        </view>
        <view class="filter-section filter-sort-section">
          <text class="filter-section-title">排序</text>
          <view class="filter-options filter-sort-options">
            <button class="filter-option {{draftSort === item.key ? 'active' : ''}}" wx:for="{{sortOptions}}" wx:key="key" data-sort="{{item.key}}" catchtap="selectDraftSort">{{item.label}}</button>
          </view>
        </view>
      </view>
      <view class="filter-actions">
        <button class="filter-reset" catchtap="resetFilter">重置</button>
        <button class="filter-apply" catchtap="applyFilter">应用筛选</button>
      </view>
    </view>
  </view>

  <view class="cart-float">
    <mall-cart-entry id="cart-entry" count="{{cartCount}}" selected="{{cartCount > 0}}" bind:entrytap="goCart" />
    <button class="cart-summary" bindtap="goCart">
      <view class="product-name">已选 {{cartCount}} 件</view>
      <view class="small">进入购物车确认价格</view>
    </button>
    <button class="button-primary" bindtap="goCart">去结算</button>
  </view>

  <view class="qcg-tabbar">
    <button class="qcg-tab" bindtap="goHome"><text class="tab-ico">首</text><text>首页</text></button>
    <button class="qcg-tab active"><text class="tab-ico">类</text><text>分类</text></button>
    <button class="qcg-tab" bindtap="goCart"><text class="tab-ico">车</text><text>购物车</text></button>
    <button class="qcg-tab" bindtap="goOrders"><text class="tab-ico">单</text><text>订单</text></button>
    <button class="qcg-tab" bindtap="goMe"><text class="tab-ico">我</text><text>我的</text></button>
  </view>
</view>
