/* 页面级滚动彻底关闭：整页 100vh 定高，只有右栏 scroll-view 在滚 */
page {
  height: 100%;
  overflow: hidden;
}

.category-page {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 100vw;
  height: 100vh;
  min-height: 100vh;
  max-height: 100vh;
  padding: 24rpx 20rpx 0;
  overflow: hidden;
  box-sizing: border-box;
}

/* 顶部区（返回栏 + 客户态提示 + 搜索）固定，不参与滚动 */
.category-header {
  flex: 0 0 auto;
  width: 100%;
}

.filter-trigger.active {
  border-color: #0f8f5f;
  background: #e8f7ee;
  color: #0f8f5f;
}

.category-page .search {
  display: flex;
  align-items: center;
  gap: 10rpx;
  width: 100%;
  min-height: 88rpx;
  height: 88rpx;
  padding: 0 14rpx 0 16rpx;
  border-radius: 18rpx;
}

.category-page .search > text {
  flex: 0 0 auto;
}

.search-icon {
  position: relative;
  flex: 0 0 30rpx;
  width: 24rpx;
  height: 24rpx;
  border: 4rpx solid #8a968e;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.search-icon::after {
  position: absolute;
  right: -9rpx;
  bottom: -7rpx;
  width: 11rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #8a968e;
  content: "";
  transform: rotate(45deg);
}

.category-page .search input {
  flex: 1 1 auto;
  min-width: 0;
  height: 68rpx;
  min-height: 68rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 30rpx;
}

.category-page .search .button-primary {
  flex: 0 0 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  min-width: 112rpx;
  height: 64rpx;
  min-height: 64rpx;
  padding: 0;
  border-radius: 16rpx;
  font-size: 30rpx;
  line-height: normal;
  white-space: nowrap;
}

.category-page .search .button-clear {
  flex: 0 0 44rpx;
  width: 44rpx;
  height: 54rpx;
  padding: 0;
  border: 0;
  background: transparent;
  color: #7a8b82;
  font-size: 34rpx;
  line-height: 54rpx;
}

/* 左右两列：左栏定宽不滚，右栏 flex 撑满剩余空间。
   右栏高度 = 100vh − 顶部区，由 flex + min-height:0 交给引擎算，
   不手写 calc(100vh - Npx)，刘海屏 / 安全区 / 字体变化都不会把页面撑长。 */
.category-layout {
  display: flex;
  flex: 1 1 auto;
  align-items: stretch;
  gap: 12rpx;
  width: 100%;
  min-height: 0;
  overflow: hidden;
}

.side-cats,
.product-pane {
  min-width: 0;
  min-height: 0;
  max-width: 100%;
}

.side-cats {
  flex: 0 0 180rpx;
  width: 180rpx;
  min-width: 180rpx;
  max-width: 180rpx;
  height: 100%;
  padding: 16rpx 0;
  border: 1rpx solid #e2e9e3;
  border-radius: 16rpx;
  background: #f8fbf8;
  overflow: hidden;
  box-sizing: border-box;
}

/* 左栏一级分类：图标在上、文字在下（保持「图标+文字」垂直结构），整块可点 */
.side-category-group {
  margin: 0 8rpx 12rpx;
}

.side-category-group:last-child {
  margin-bottom: 0;
}

.category-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 100%;
  padding: 14rpx 6rpx;
  border-radius: 14rpx;
  /* 未选中：浅灰底 + 深灰字 */
  background: #f1f4f2;
  color: #5c6660;
  text-align: center;
  box-sizing: border-box;
}

/* 图标外圈：固定 64rpx，保证 180rpx 窄栏下图标与文字都不挤 */
.category-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: transparent;
  box-sizing: border-box;
}

.category-icon {
  display: block;
  width: 60rpx;
  height: 60rpx;
}

.category-initial {
  color: inherit;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1;
}

.category-name {
  display: block;
  width: 100%;
  color: inherit;
  font-size: 26rpx;
  font-weight: 400;
  line-height: 1.25;
  overflow-wrap: break-word;
}

/* 选中态：主题色绿底 + 白字加粗 */
.category-item.active {
  background: #00b26a;
  color: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(0, 178, 106, 0.24);
}

.category-item.active .category-name {
  color: #ffffff;
  font-weight: 700;
}

/* 选中时把图标垫到白色圆底上，彩色插画压在绿底上才不会糊 */
.category-item.active .category-icon-wrap {
  background: #ffffff;
}

.side-cat-badge {
  display: inline-flex;
  max-width: 100rpx;
  min-height: 26rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: #e4eae6;
  color: #708078;
  font-size: 20rpx;
  line-height: 26rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-item.active .side-cat-badge {
  background: rgba(255, 255, 255, 0.24);
  color: #ffffff;
}

.side-subcats {
  margin: 2rpx 6rpx 7rpx 12rpx;
  padding: 6rpx 0 6rpx 7rpx;
  border-left: 3rpx solid #b9dfc8;
}

.side-subcats-title {
  display: block;
  margin: 0 5rpx 4rpx;
  color: #8a968e;
  font-size: 20rpx;
  line-height: 1.15;
}

/* 二级分类：字号比一级小（一级 26rpx → 二级 22rpx），窄栏下才不会挤 */
.side-subcat {
  position: relative;
  display: block;
  width: 100%;
  min-height: 52rpx;
  padding: 8rpx 6rpx 8rpx 14rpx;
  border-radius: 9rpx;
  /* 未选中：灰色字 */
  color: #666666;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 1.28;
  text-align: left;
  word-break: break-all;
}

/* 未选中标识：小圆点 */
.side-subcat::before {
  position: absolute;
  left: 1rpx;
  top: 50%;
  width: 5rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: #c3cec7;
  content: "";
  transform: translateY(-50%);
}

/* 选中（滚动联动 / 点击联动写入）：主题绿文字 + 加粗 + 左侧绿色竖线 */
.side-subcat.active {
  background: rgba(0, 178, 106, 0.08);
  color: #00b26a;
  font-weight: 700;
}

.side-subcat.active::before {
  top: 50%;
  width: 5rpx;
  height: 26rpx;
  border-radius: 999rpx;
  background: #00b26a;
}

/* 右栏：工具栏固定不滚，商品区（.pane-scroll）独立滚动 */
.product-pane {
  display: flex;
  flex: 1 1 auto;
  flex-direction: column;
  width: auto;
  height: 100%;
  min-height: 0;
  box-sizing: border-box;
}

.pane-scroll {
  flex: 1 1 auto;
  width: 100%;
  min-height: 0;
  /* 高度兜底：JS 实测后会回写内联 px；flex 生效时二者一致 */
  box-sizing: border-box;
}

/* 底部留白：避开固定在底部的购物车条与导航栏，最后一张卡片不会被盖住 */
.pane-inner {
  width: 100%;
  padding-bottom: calc(300rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 右栏顶部锚点（scroll-into-view 目标），不占视觉高度 */
.pane-top {
  width: 100%;
  height: 1rpx;
}

/* ---- 分区：每个一级分类一个区块 ------------------------------------------ */
.section {
  width: 100%;
  padding-top: 6rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  padding: 10rpx 4rpx 8rpx;
}

.section-title {
  position: relative;
  padding-left: 16rpx;
  color: #1f2a24;
  font-size: 29rpx;
  font-weight: 800;
}

.section-title::before {
  position: absolute;
  left: 0;
  top: 50%;
  width: 6rpx;
  height: 26rpx;
  border-radius: 999rpx;
  background: #00b26a;
  content: "";
  transform: translateY(-50%);
}

.section-count {
  flex: 0 0 auto;
  color: #7a8b82;
  font-size: 21rpx;
  white-space: nowrap;
}

/* ---- 二级分类分组：分区内的小标题 + 该组商品 ---------------------------- */
/* 重要：小标题不要写 position:sticky。吸顶后 measured offsetTop 会随滚动变化，
   二级联动的高亮换算就会错位。 */
.sub-section {
  width: 100%;
  padding-top: 4rpx;
}

.sub-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  padding: 10rpx 6rpx 8rpx;
}

.sub-section-title {
  position: relative;
  padding-left: 14rpx;
  color: #3d4b43;
  font-size: 25rpx;
  font-weight: 700;
}

.sub-section-title::before {
  position: absolute;
  left: 0;
  top: 50%;
  width: 4rpx;
  height: 18rpx;
  border-radius: 999rpx;
  background: #9fd9bd;
  content: "";
  transform: translateY(-50%);
}

.sub-section-count {
  flex: 0 0 auto;
  color: #93a29a;
  font-size: 20rpx;
  white-space: nowrap;
}

.sub-section-empty {
  padding: 16rpx 12rpx;
  color: #9aa8a0;
  font-size: 22rpx;
  text-align: center;
}

.section-state {
  min-height: 96rpx;
  padding: 20rpx 12rpx;
  color: #7a8b82;
  font-size: 24rpx;
  text-align: center;
  box-sizing: border-box;
}

.section-state--tail {
  min-height: 56rpx;
  padding: 12rpx;
  font-size: 22rpx;
}

.section-error {
  padding: 8rpx 12rpx 0;
  color: #c0392b;
  font-size: 22rpx;
  text-align: center;
}

.load-more-button {
  width: 100%;
  height: 72rpx;
  margin: 8rpx 0 18rpx;
  border: 1rpx solid #cfe1d6;
  border-radius: 16rpx;
  background: #f1f8f4;
  color: #0f754f;
  font-size: 25rpx;
  font-weight: 700;
}

.catalog-summary {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  min-height: 40rpx;
  margin-bottom: 8rpx;
  padding: 0 4rpx;
  box-sizing: border-box;
}

.catalog-title {
  min-width: 0;
  overflow: hidden;
  color: #33443a;
  font-size: 28rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.catalog-count {
  flex: 0 0 auto;
  margin-left: 8rpx;
  color: #7a8b82;
  font-size: 22rpx;
  white-space: nowrap;
}

.catalog-toolbar {
  /* 作为右栏 flex 列的第一段固定高度，避免 scroll-x 容器在 flex 里被压成 0 高 */
  flex: 0 0 auto;
  width: 100%;
  min-height: 62rpx;
  margin-bottom: 12rpx;
  white-space: nowrap;
}

.catalog-toolbar-inner {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 116rpx 82rpx 82rpx;
  align-items: center;
  gap: 8rpx;
  width: 100%;
  min-width: 0;
}

.catalog-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  height: 62rpx;
  min-height: 62rpx;
  margin: 0;
  padding: 0 10rpx;
  border: 1rpx solid #d7e1da;
  border-radius: 999rpx;
  background: #ffffff;
  color: #46584d;
  font-size: 24rpx;
  line-height: normal;
  overflow: hidden;
  text-align: center;
  white-space: nowrap;
}

.catalog-chip.brand-chip {
  padding: 0 14rpx;
}

.catalog-chip-label {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.catalog-chip-chevron {
  flex: 0 0 auto;
  margin-left: 5rpx;
}

.catalog-chip.active {
  border-color: #0f8f5f;
  background: #eaf7ef;
  color: #0b754e;
  font-weight: 800;
}

.product-pane .product-card {
  width: 100%;
  max-width: 100%;
  min-height: 250rpx;
  margin-bottom: 14rpx;
  padding: 14rpx;
  border-radius: 18rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.product-pane .product-card--pressed {
  background: #f3faf6;
  transform: scale(0.995);
}

.category-page .product-row {
  display: grid;
  grid-template-columns: 142rpx minmax(0, 1fr);
  gap: 12rpx;
  align-items: stretch;
  width: 100%;
  min-height: 222rpx;
}

.category-page .product-thumb {
  width: 142rpx;
  height: 142rpx;
  aspect-ratio: 1 / 1;
  align-self: center;
  padding: 6rpx;
  border-radius: 14rpx;
  background: #f5f7f5;
  overflow: hidden;
  box-sizing: border-box;
}

.category-page .product-thumb-image,
.product-thumb-fallback {
  width: 100%;
  height: 100%;
}

.category-page .product-thumb-image {
  display: block;
  object-position: center;
}

.product-thumb-fallback {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #0f8f5f;
}

.placeholder-pack {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 74rpx;
  height: 88rpx;
  border: 3rpx solid #7db89b;
  border-radius: 12rpx 12rpx 16rpx 16rpx;
  background: linear-gradient(180deg, #eef8f2, #dcefe5);
  color: #438264;
  font-size: 20rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.placeholder-pack view {
  position: absolute;
  top: -13rpx;
  width: 38rpx;
  height: 16rpx;
  border-radius: 8rpx 8rpx 2rpx 2rpx;
  background: #7db89b;
}

.fallback-label {
  color: #8a968e;
  font-size: 20rpx;
  font-weight: 500;
}

.product-info {
  display: flex;
  flex-direction: column;
  min-width: 0;
  min-height: 222rpx;
  align-self: center;
}

.category-page .product-name {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  width: 100%;
  min-height: 34rpx;
  max-height: 68rpx;
  overflow: hidden;
  color: #1f2a24;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 34rpx;
  text-align: left;
  word-break: break-word;
}

.status-line {
  height: 32rpx;
  margin-top: 4rpx;
  overflow: hidden;
}

.status-tag {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  height: 32rpx;
  padding: 0 9rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: #f0f3f1;
  color: #6f7d75;
  font-size: 21rpx;
  line-height: 32rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-sizing: border-box;
}

.status-tag.ready {
  background: #e5f6ec;
  color: #0f8f5f;
}

.product-action-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
  height: 88rpx;
  margin-top: auto;
}

.price-copy {
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
}

.category-page .money {
  color: #df2d24;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 44rpx;
}

.price-line {
  display: flex;
  align-items: baseline;
  min-width: 0;
  color: #df2d24;
  white-space: nowrap;
}

.price-unit {
  flex: 0 0 auto;
  font-size: 18rpx;
  font-weight: 800;
}

.category-page .blank-price {
  display: block;
  overflow: hidden;
  color: #7a8b82;
  font-size: 21rpx;
  line-height: 44rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.unit-summary {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 5rpx;
  width: 100%;
  min-width: 0;
  min-height: 52rpx;
  margin-top: 6rpx;
  padding: 0 10rpx;
  border: 1rpx solid #d9e4dd;
  border-radius: 10rpx;
  background: #f7faf8;
  color: #34443b;
  overflow: hidden;
  text-align: left;
  box-sizing: border-box;
}

.unit-summary-copy {
  display: grid;
  flex: 1 1 auto;
  min-width: 0;
  gap: 1rpx;
}

.unit-primary,
.unit-secondary {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.unit-primary {
  color: #26352c;
  font-size: 24rpx;
  font-weight: 800;
}

.unit-secondary {
  color: #7a8780;
  font-size: 18rpx;
}

.unit-chevron {
  flex: 0 0 auto;
  color: #6f7d75;
  font-size: 21rpx;
}

.category-page .detail-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  min-height: 68rpx;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  line-height: normal;
  border-radius: 999rpx;
}

.detail-btn-face {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  border-radius: 999rpx;
  background: #0f8f5f;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1;
  box-shadow: 0 4rpx 12rpx rgba(15, 143, 95, 0.2);
}

.detail-btn--pressed .detail-btn-face {
  background: #0b754f;
  transform: scale(0.94);
}

.filter-mask {
  position: fixed;
  inset: 0;
  z-index: 90;
  background: rgba(15, 35, 24, 0.4);
}

.filter-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 91;
  display: flex;
  flex-direction: column;
  width: 100%;
  min-height: 440rpx;
  max-height: 70vh;
  padding: 24rpx 28rpx 0;
  border-radius: 24rpx 24rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -12rpx 40rpx rgba(17, 44, 29, 0.18);
  box-sizing: border-box;
  overflow: hidden;
}

.filter-sheet-head {
  position: relative;
  display: block;
  flex: 0 0 auto;
  width: 100%;
  min-height: 88rpx;
  padding-right: 100rpx;
  box-sizing: border-box;
}

.filter-heading-copy {
  width: 100%;
  min-width: 0;
}

.filter-title,
.filter-subtitle,
.filter-section-title {
  display: block;
}

.filter-title {
  color: #1f2a24;
  font-size: 32rpx;
  font-weight: 800;
}

.filter-subtitle {
  margin-top: 6rpx;
  color: #7a8b82;
  font-size: 23rpx;
}

.filter-close {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  min-width: 88rpx;
  max-width: 88rpx;
  height: 88rpx;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  line-height: normal;
}

.filter-close-face {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: #f2f6f3;
  color: #53645a;
  font-size: 34rpx;
  line-height: normal;
}

.filter-body {
  flex: 1 1 auto;
  min-height: 0;
  overflow: hidden;
}

.filter-section {
  margin-top: 22rpx;
}

.filter-section-title {
  margin-bottom: 16rpx;
  color: #33443a;
  font-size: 25rpx;
  font-weight: 800;
}

.filter-options {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx 16rpx;
  width: 100%;
}

.filter-brand-scroll {
  width: 100%;
  max-height: 248rpx;
}

.filter-option {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  height: 70rpx;
  min-height: 70rpx;
  margin: 0;
  padding: 0 12rpx;
  border: 1rpx solid #dce8df;
  border-radius: 16rpx;
  background: #f8fbf8;
  color: #53645a;
  font-size: 25rpx;
  line-height: normal;
  overflow: hidden;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-sizing: border-box;
}

.filter-option.active {
  border-color: #0f8f5f;
  background: #e8f7ee;
  color: #0f754f;
  font-weight: 800;
}

.filter-actions {
  flex: 0 0 auto;
  display: grid;
  grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
  gap: 16rpx;
  min-height: 120rpx;
  margin: 22rpx -28rpx 0;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e5ebe7;
  background: #ffffff;
  box-sizing: content-box;
}

.filter-reset,
.filter-apply {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 80rpx;
  min-height: 80rpx;
  margin: 0;
  padding: 0 16rpx;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 800;
  line-height: normal;
  text-align: center;
  white-space: nowrap;
  box-sizing: border-box;
}

.filter-reset {
  border: 1rpx solid #d9e4dd;
  background: #f2f6f3;
  color: #3d5045;
}

.filter-apply {
  border: 1rpx solid #0f8f5f;
  background: #0f8f5f;
  color: #ffffff;
}

.category-page .cart-float {
  left: 20rpx;
  right: 20rpx;
  bottom: calc(108rpx + env(safe-area-inset-bottom));
  grid-template-columns: 72rpx minmax(0, 1fr) 138rpx;
  z-index: 60;
  overflow: visible;
}

.category-page .cart-float mall-cart-entry {
  position: relative;
  z-index: 61;
  overflow: visible;
}

.empty-state {
  display: flex;
  min-height: 360rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 36rpx 24rpx;
  box-sizing: border-box;
}

.empty-title {
  color: #33443a;
  font-size: 30rpx;
  font-weight: 800;
}

.empty-desc {
  color: #7a8b82;
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
}

@media screen and (min-width: 420px) {
  .category-page .product-thumb {
    width: 148rpx;
    height: 148rpx;
  }
}

/* 分类名与二级分类名最多两行，防止 180rpx 窄栏被长名称撑开 */
.category-name, .side-subcat {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  white-space: normal;
  word-break: normal;
  text-overflow: ellipsis;
}
.category-name { max-height: 66rpx; }
.side-subcat { max-height: 74rpx; box-sizing: border-box; }
.unit-primary { color: #58675e; font-weight: 500; }

/* 左栏宽度由 .side-cats 统一控制（180rpx）；这里只收口二级分类缩进与商品卡宽度 */
.side-subcats { margin-left: 6rpx; padding-left: 5rpx; }
/* 二级字号必须比一级小（一级 26rpx → 二级 22rpx） */
.side-subcat { padding-left: 12rpx; padding-right: 6rpx; font-size: 22rpx; max-height: 74rpx; }
.product-pane .product-card { width: 100%; }
